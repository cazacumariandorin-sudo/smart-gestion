{
  "name": "Generar ID \u00fanico para Planos",
  "description": "Asigna autom\u00e1ticamente el c\u00f3digo PLN-AA-SSSSS a cada plano nuevo al crearse",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Drawing"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generar_id_nico_para_planos",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generarIdUnico",
            "args": {
              "entidad": "Drawing",
              "campo_id": "codigo_registro"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generarIdUnico"
  }
}