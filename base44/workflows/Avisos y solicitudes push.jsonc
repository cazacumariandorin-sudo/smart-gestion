{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "avisos_solicitudes_push",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notificar_aviso": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarPush",
            "args": {
              "tipo": "auto",
              "referencia_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar aviso o solicitud"
          }
        }
      }
    ]
  },
  "name": "Avisos y solicitudes push",
  "description": "Envia una notificacion push nativa cuando se crea un aviso o una solicitud para Gerencia o Administracion. Los destinatarios se resuelven en el servidor.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "AsistenteTarea"
    }
  }
}