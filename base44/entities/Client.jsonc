{
  "name": "Client",
  "type": "object",
  "properties": {
    "active": {
      "default": true,
      "description": "Cliente activo",
      "type": "boolean"
    },
    "address": {
      "description": "Direcci\u00f3n",
      "type": "string"
    },
    "client_id_code": {
      "description": "ID \u00fanico generado",
      "type": "string"
    },
    "contact_person": {
      "description": "Persona de contacto principal",
      "type": "string"
    },
    "contacto_admin": {
      "description": "Contacto Administraci\u00f3n",
      "properties": {
        "email": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "contacto_facturacion": {
      "description": "Contacto Facturaci\u00f3n",
      "properties": {
        "email": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "email": {
      "description": "Email principal",
      "type": "string"
    },
    "name": {
      "description": "Nombre del cliente",
      "type": "string"
    },
    "nif": {
      "description": "NIF / CIF",
      "type": "string"
    },
    "notes": {
      "description": "Observaciones",
      "type": "string"
    },
    "phone": {
      "description": "Tel\u00e9fono",
      "type": "string"
    },
    "postal_code": {
      "description": "C\u00f3digo postal",
      "type": "string"
    },
    "tecnicos": {
      "description": "T\u00e9cnicos de contacto (hasta 4)",
      "items": {
        "properties": {
          "cargo": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "usuario_vinculado_email": {
      "description": "Email del usuario vinculado",
      "type": "string"
    },
    "usuario_vinculado_id": {
      "description": "ID del usuario vinculado",
      "type": "string"
    },
    "usuario_vinculado_nombre": {
      "description": "Nombre del usuario vinculado",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}