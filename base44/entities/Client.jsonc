{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "nif": {
      "type": "string",
      "description": "NIF / CIF"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Cliente activo"
    },
    "contacto_admin": {
      "type": "object",
      "description": "Contacto Administraci\u00f3n",
      "properties": {
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "contacto_facturacion": {
      "type": "object",
      "description": "Contacto Facturaci\u00f3n",
      "properties": {
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "tecnicos": {
      "type": "array",
      "description": "T\u00e9cnicos de contacto (hasta 4)",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "cargo": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}