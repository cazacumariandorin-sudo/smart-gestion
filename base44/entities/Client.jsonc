{
  "name": "Client",
  "properties": {
    "active": {
      "default": true,
      "description": "Cliente activo",
      "type": "boolean"
    },
    "address": {
      "description": "Direcci\u00f3n",
      "type": "string"
    },
    "client_id_code": {
      "description": "ID \u00fanico generado",
      "type": "string"
    },
    "codigo_cliente": {
      "description": "C\u00f3digo \u00fanico y secuencial del cliente (C001, C002\u2026). Se usa en el n\u00famero de parte.",
      "type": "string"
    },
    "contacto_admin": {
      "description": "Contacto Administraci\u00f3n",
      "properties": {
        "email": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "contacto_facturacion": {
      "description": "Contacto Facturaci\u00f3n",
      "properties": {
        "email": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "email": {
      "description": "Email general (importado de contabilidad)",
      "type": "string"
    },
    "localidad": {
      "description": "Poblaci\u00f3n / localidad (importada de contabilidad)",
      "type": "string"
    },
    "name": {
      "description": "Nombre del cliente",
      "type": "string"
    },
    "nif": {
      "description": "NIF / CIF",
      "type": "string"
    },
    "notes": {
      "description": "Observaciones",
      "type": "string"
    },
    "pais": {
      "description": "Pa\u00eds (importado de contabilidad)",
      "type": "string"
    },
    "postal_code": {
      "description": "C\u00f3digo postal",
      "type": "string"
    },
    "provincia": {
      "description": "Provincia (importada de contabilidad)",
      "type": "string"
    },
    "tecnicos": {
      "description": "T\u00e9cnicos de contacto (hasta 4)",
      "items": {
        "properties": {
          "cargo": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "telefono": {
      "description": "Tel\u00e9fono general (importado de contabilidad)",
      "type": "string"
    },
    "web": {
      "description": "Web (importada de contabilidad)",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  },
  "type": "object"
}