{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "nif": {
      "type": "string",
      "description": "NIF / CIF"
    },
    "address": {
      "type": "string",
      "description": "Dirección"
    },
    "postal_code": {
      "type": "string",
      "description": "Código postal"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Cliente activo"
    },
    "client_id_code": {
      "type": "string",
      "description": "ID único generado"
    },
    "contacto_admin": {
      "type": "object",
      "description": "Contacto Administración",
      "properties": {
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "contacto_facturacion": {
      "type": "object",
      "description": "Contacto Facturación",
      "properties": {
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "tecnicos": {
      "type": "array",
      "description": "Técnicos de contacto (hasta 4)",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "cargo": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}
