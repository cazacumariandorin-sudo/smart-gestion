{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "nif": {
      "type": "string",
      "description": "NIF / CIF"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n"
    },
    "postal_code": {
      "type": "string",
      "description": "C\u00f3digo postal"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Cliente activo"
    },
    "client_id_code": {
      "type": "string",
      "description": "ID \u00fanico generado: Client Id-PPYYXXX (2 primeros d\u00edgitos CP + 2 \u00faltimos a\u00f1o + 3 \u00faltimos d\u00edgitos NIF)"
    },
    "contacto_admin": {
      "type": "object",
      "description": "Contacto Administraci\u00f3n",
      "properties": {
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "contacto_facturacion": {
      "type": "object",
      "description": "Contacto Facturaci\u00f3n",
      "properties": {
        "nombre": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "tecnicos": {
      "type": "array",
      "description": "T\u00e9cnicos de contacto (hasta 4)",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "cargo": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}