{
  "name": "NotaMensualGasto",
  "type": "object",
  "properties": {
    "ciclo_mes": {
      "description": "Mes del ciclo YYYY-MM",
      "type": "string"
    },
    "numero_ciclo": {
      "description": "Código legible del ciclo (CIC-YYYY-MM-<operario_short>). Sirve para referencia humana y ordenación.",
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "fecha_apertura": {
      "description": "Fecha en que se abrió automáticamente el ciclo (día 26 del mes anterior o por backfill).",
      "format": "date",
      "type": "string"
    },
    "fecha_cierre": {
      "description": "Día 25 del mes del ciclo (o fecha real de cierre si se cerró antes/tarde).",
      "format": "date",
      "type": "string"
    },
    "registros_ids": {
      "description": "IDs de RegistroGasto incluidos en el ciclo",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "total_registros": {
      "default": 0,
      "type": "number"
    },
    "total_importe": {
      "default": 0,
      "type": "number"
    },
    "importe_adelanto": {
      "default": 0,
      "description": "Adelanto recibido ese mes",
      "type": "number"
    },
    "saldo_pendiente": {
      "default": 0,
      "description": "total_importe - importe_adelanto",
      "type": "number"
    },
    "estado": {
      "default": "borrador",
      "enum": [
        "borrador",
        "enviada",
        "aprobada",
        "en_contabilidad",
        "pagada",
        "rechazada"
      ],
      "type": "string"
    },
    "metodo_pago": {
      "enum": [
        "transferencia",
        "efectivo",
        "tarjeta_empresa",
        "sepa"
      ],
      "type": "string"
    },
    "aprobado_por": {
      "type": "string"
    },
    "fecha_aprobacion": {
      "type": "string"
    },
    "pagado_por": {
      "type": "string"
    },
    "fecha_pago": {
      "type": "string"
    },
    "notas_gerencia": {
      "type": "string"
    },
    "export_contabilidad_url": {
      "description": "URL del PDF índice + ZIP de tickets subido a Drive (Fase 4). Se rellena al ejecutar exportarCicloContabilidad.",
      "type": "string"
    },
    "fecha_export_contabilidad": {
      "description": "Fecha ISO en que se exportó el ciclo a contabilidad.",
      "type": "string"
    }
  },
  "required": [
    "ciclo_mes",
    "operario_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "data.operario_email": "{{user.email}}"
                },
                {
                  "created_by": "{{user.email}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": {
                "$in": [
                  "borrador",
                  "enviada"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
