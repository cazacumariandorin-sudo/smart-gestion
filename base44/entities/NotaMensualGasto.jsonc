{
  "name": "NotaMensualGasto",
  "type": "object",
  "properties": {
    "ciclo_mes": {
      "description": "Mes del ciclo YYYY-MM",
      "type": "string"
    },
    "numero_ciclo": {
      "description": "C\u00f3digo legible del ciclo (CIC-YYYY-MM-<operario_short>). Sirve para referencia humana y ordenaci\u00f3n.",
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "fecha_apertura": {
      "description": "Fecha en que se abri\u00f3 autom\u00e1ticamente el ciclo (d\u00eda 26 del mes anterior o por backfill).",
      "format": "date",
      "type": "string"
    },
    "fecha_cierre": {
      "description": "D\u00eda 25 del mes del ciclo (o fecha real de cierre si se cerr\u00f3 antes/tarde).",
      "format": "date",
      "type": "string"
    },
    "registros_ids": {
      "description": "IDs de RegistroGasto incluidos en el ciclo",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "total_registros": {
      "default": 0,
      "type": "number"
    },
    "total_importe": {
      "default": 0,
      "type": "number"
    },
    "importe_adelanto": {
      "default": 0,
      "description": "CALCULADO a partir de Adelanto tipo=gastos del ciclo. Para ciclos anteriores a la implementaci\u00f3n de Adelanto, conserva el valor hist\u00f3rico manual (ver es_historico_adelanto).",
      "type": "number"
    },
    "total_adelantos_gastos": {
      "default": 0,
      "description": "Suma de Adelanto tipo=gastos entregados del ciclo (campo calculado).",
      "type": "number"
    },
    "total_adelantos_dieta": {
      "default": 0,
      "description": "Suma de Adelanto tipo=dieta del ciclo (informativo, no resta del c\u00e1lculo de gastos).",
      "type": "number"
    },
    "importe_neto_liquidar": {
      "default": 0,
      "description": "total_importe \u2212 total_adelantos_gastos. Positivo = empresa debe al t\u00e9cnico; negativo = t\u00e9cnico debe devolver.",
      "type": "number"
    },
    "es_historico_adelanto": {
      "default": false,
      "description": "True si el ciclo tiene importe_adelanto anterior a la implementaci\u00f3n de Adelanto (no se recalcula autom\u00e1ticamente). Gerencia lo revisa manualmente.",
      "type": "boolean"
    },
    "saldo_pendiente": {
      "default": 0,
      "description": "Alias de importe_neto_liquidar (retrocompatibilidad).",
      "type": "number"
    },
    "estado": {
      "default": "borrador",
      "enum": [
        "borrador",
        "enviada",
        "aprobada",
        "en_contabilidad",
        "pagada",
        "rechazada"
      ],
      "type": "string"
    },
    "metodo_pago": {
      "enum": [
        "transferencia",
        "efectivo",
        "tarjeta_empresa",
        "sepa"
      ],
      "type": "string"
    },
    "aprobado_por": {
      "type": "string"
    },
    "fecha_aprobacion": {
      "type": "string"
    },
    "pagado_por": {
      "type": "string"
    },
    "fecha_pago": {
      "type": "string"
    },
    "notas_gerencia": {
      "type": "string"
    },
    "export_contabilidad_url": {
      "description": "URL del PDF \u00edndice + ZIP de tickets subido a Drive (Fase 4). Se rellena al ejecutar exportarCicloContabilidad.",
      "type": "string"
    },
    "fecha_export_contabilidad": {
      "description": "Fecha ISO en que se export\u00f3 el ciclo a contabilidad.",
      "type": "string"
    }
  },
  "required": [
    "ciclo_mes",
    "operario_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "data.operario_email": "{{user.email}}"
                },
                {
                  "created_by": "{{user.email}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": {
                "$in": [
                  "borrador",
                  "enviada"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}