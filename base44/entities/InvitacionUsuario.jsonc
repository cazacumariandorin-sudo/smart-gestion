{
  "name": "InvitacionUsuario",
  "type": "object",
  "description": "Invitaci\u00f3n de un usuario a una empresa concreta. Cada empresa gestiona las suyas: nadie de otra empresa puede leerlas ni modificarlas. La invitaci\u00f3n NO concede acceso por s\u00ed sola: la persona invitada debe confirmarla desde su sesi\u00f3n y solo entonces el backend le asigna el empresa_id y el rol.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email del invitado \u2014 ancla de identidad de la invitaci\u00f3n."
    },
    "rol": {
      "type": "string",
      "description": "Rol que se aplicar\u00e1 al User cuando confirme la invitaci\u00f3n."
    },
    "tipo": {
      "type": "string",
      "enum": [
        "administrador_local",
        "empleado"
      ],
      "enumColors": [
        "purple",
        "blue"
      ],
      "default": "empleado",
      "description": "administrador_local = abre la empresa y la administra; empleado = se incorpora a la plantilla de una empresa existente."
    },
    "full_name": {
      "type": "string",
      "description": "Nombre completo deseado para el usuario"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo / puesto que ocupar\u00e1 en la empresa"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID de la empresa (entidad Empresa) a la que se vincula. Frontera de aislamiento de la invitaci\u00f3n."
    },
    "empresa_nombre": {
      "type": "string",
      "description": "Nombre de la empresa (desnormalizado)"
    },
    "acceso_hasta": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha opcional de expiraci\u00f3n del acceso"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente_activacion",
        "activado",
        "expirado",
        "suspendido",
        "rechazada"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray",
        "red",
        "red"
      ],
      "default": "pendiente_activacion",
      "description": "pendiente_activacion = espera que la persona la confirme; activado = confirmada y acceso concedido; expirado = caducada; suspendido = revocada por la empresa; rechazada = la persona invitada la declin\u00f3."
    },
    "confirmada": {
      "type": "boolean",
      "default": false,
      "description": "True solo cuando la persona invitada acept\u00f3 expl\u00edcitamente desde su sesi\u00f3n. Sin esto no hay acceso."
    },
    "confirmada_en": {
      "type": "string",
      "format": "date-time"
    },
    "confirmada_por_email": {
      "type": "string",
      "description": "Email de la sesi\u00f3n que confirm\u00f3 (debe coincidir con el invitado)."
    },
    "registrado_en": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que se detect\u00f3 una cuenta con este email. Es solo informativo: no activa la invitaci\u00f3n."
    },
    "solicitud_empresa_id": {
      "type": "string",
      "description": "Solicitud de alta que origin\u00f3 esta invitaci\u00f3n (cuando la empresa nace de una solicitud)."
    },
    "invitado_por": {
      "type": "string",
      "description": "Email de quien cre\u00f3 la invitaci\u00f3n (administrador de la empresa o propietario)"
    },
    "fecha_invitacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del \u00faltimo env\u00edo de la invitaci\u00f3n"
    },
    "user_id_registrado": {
      "type": "string",
      "description": "ID del User una vez confirmada la invitaci\u00f3n"
    },
    "fecha_aceptacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el usuario confirm\u00f3 la invitaci\u00f3n"
    },
    "suspendido_por": {
      "type": "string",
      "description": "Email de quien revoc\u00f3 la invitaci\u00f3n"
    },
    "fecha_suspension": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_suspension": {
      "type": "string",
      "description": "Motivo de la revocaci\u00f3n o del rechazo"
    },
    "notas": {
      "type": "string",
      "description": "Notas internas sobre la invitaci\u00f3n"
    },
    "historial": {
      "type": "array",
      "description": "Trazabilidad de la invitaci\u00f3n: env\u00edo, reenv\u00edo, confirmaci\u00f3n, rechazo o revocaci\u00f3n.",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "usuario_email": {
            "type": "string"
          },
          "accion": {
            "type": "string"
          },
          "nota": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "email",
    "estado"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "propietario"
                  }
                },
                {
                  "user_condition": {
                    "role": "gerencia"
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "es_propietario_global": true
                  }
                },
                {
                  "user_condition": {
                    "role": "propietario"
                  }
                },
                {
                  "data.empresa_id": "{{user.data.empresa_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    }
  }
}