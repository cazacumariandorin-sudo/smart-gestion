{
  "name": "InvitacionUsuario",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email del invitado — clave de coincidencia con el User cuando acepte"
    },
    "rol": {
      "type": "string",
      "description": "Rol personalizado que se aplicará al User tras aceptar"
    },
    "full_name": {
      "type": "string",
      "description": "Nombre completo deseado para el usuario"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo / puesto que ocupará en la empresa"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID de la empresa (entidad Empresa) a la que se vincula como empleado"
    },
    "empresa_nombre": {
      "type": "string",
      "description": "Nombre de la empresa (desnormalizado)"
    },
    "acceso_hasta": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha opcional de expiración del acceso"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente_activacion",
        "activado",
        "expirado",
        "suspendido"
      ],
      "default": "pendiente_activacion",
      "description": "Estado del ciclo de vida de la invitación"
    },
    "invitado_por": {
      "type": "string",
      "description": "Email del gerente/admin que creó la invitación"
    },
    "fecha_invitacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se envió la invitación"
    },
    "user_id_registrado": {
      "type": "string",
      "description": "ID del User una vez aceptada la invitación y activada la cuenta"
    },
    "fecha_aceptacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el usuario aceptó la invitación y se activó"
    },
    "suspendido_por": {
      "type": "string",
      "description": "Email del gerente/admin que suspendió la invitación"
    },
    "fecha_suspension": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la suspensión"
    },
    "motivo_suspension": {
      "type": "string",
      "description": "Motivo de la suspensión (si aplica)"
    },
    "notas": {
      "type": "string",
      "description": "Notas internas sobre la invitación"
    }
  },
  "required": [
    "email",
    "estado"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
