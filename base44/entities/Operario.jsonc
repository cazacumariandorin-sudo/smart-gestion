{
  "name": "Operario",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre completo"
    },
    "dni": {
      "type": "string",
      "description": "DNI / NIE"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico personal"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono"
    },
    "role": {
      "type": "string",
      "description": "Puesto / categor\u00eda profesional"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Activo"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario de la app vinculado a este operario (para login)"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario de la app vinculado"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}