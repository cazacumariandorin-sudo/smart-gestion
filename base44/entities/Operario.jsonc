{
  "name": "Operario",
  "properties": {
    "active": {
      "default": true,
      "description": "Activo",
      "type": "boolean"
    },
    "dni": {
      "description": "DNI / NIE",
      "type": "string"
    },
    "email": {
      "description": "Correo electr\u00f3nico personal",
      "type": "string"
    },
    "es_temporal": {
      "default": false,
      "description": "True si fue creado autom\u00e1ticamente por el sistema tras 7 d\u00edas sin vinculaci\u00f3n manual",
      "type": "boolean"
    },
    "name": {
      "description": "Nombre completo",
      "type": "string"
    },
    "phone": {
      "description": "Tel\u00e9fono",
      "type": "string"
    },
    "role": {
      "description": "Puesto / categor\u00eda profesional",
      "type": "string"
    },
    "user_email": {
      "description": "Email del usuario de la app vinculado a este operario",
      "type": "string"
    },
    "user_id": {
      "description": "ID del usuario de la app vinculado",
      "type": "string"
    },
    "user_vinculado_nombre": {
      "description": "Nombre display del usuario vinculado",
      "type": "string"
    },
    "vinculacion_fecha": {
      "description": "Fecha en que se realiz\u00f3 el v\u00ednculo con el usuario de la app",
      "format": "date-time",
      "type": "string"
    },
    "vinculacion_tipo": {
      "default": "sin_vincular",
      "description": "C\u00f3mo se realiz\u00f3 el v\u00ednculo",
      "enum": [
        "manual",
        "automatico_7dias",
        "demo",
        "sin_vincular"
      ],
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}