{
  "name": "Operario",
  "type": "object",
  "description": "Ficha laboral del trabajador. Aislada por empresa: solo se lee y edita dentro de la empresa a la que pertenece el trabajador, su propio usuario vinculado y el propietario de la app.",
  "properties": {
    "num_empleado": {
      "type": "string",
      "description": "N\u00famero de empleado \u00fanico \u2014 formato SMT-AAAA-NNNNN. Generado autom\u00e1ticamente al crear el t\u00e9cnico."
    },
    "name": {
      "type": "string",
      "description": "Nombre completo"
    },
    "dni": {
      "type": "string",
      "description": "DNI / NIE"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico personal"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono"
    },
    "role": {
      "type": "string",
      "description": "Puesto / categor\u00eda profesional"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Activo"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario de la app vinculado a este operario"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario de la app vinculado"
    },
    "user_vinculado_nombre": {
      "type": "string",
      "description": "Nombre display del usuario vinculado"
    },
    "vinculacion_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se realiz\u00f3 el v\u00ednculo con el usuario de la app"
    },
    "vinculacion_tipo": {
      "type": "string",
      "default": "sin_vincular",
      "enum": [
        "manual",
        "automatico_7dias",
        "demo",
        "sin_vincular"
      ],
      "description": "C\u00f3mo se realiz\u00f3 el v\u00ednculo"
    },
    "es_temporal": {
      "type": "boolean",
      "default": false,
      "description": "True si fue creado autom\u00e1ticamente por el sistema tras 7 d\u00edas sin vinculaci\u00f3n manual"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "oficial_primera",
        "oficial_segunda",
        "peon",
        "encargado",
        "tecnico_solar",
        "administrativo",
        "subcontrata",
        "temporal"
      ],
      "description": "Categor\u00eda profesional del trabajador"
    },
    "especialidad": {
      "type": "string",
      "description": "Especialidad t\u00e9cnica del trabajador (ej: instalaci\u00f3n fotovoltaica, electricidad, alba\u00f1iler\u00eda)"
    },
    "coste_hora": {
      "type": "number",
      "description": "Coste por hora en EUR (para c\u00e1lculo de rentabilidad de proyecto)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID de la empresa (Entidad Empresa) a la que pertenece el empleado. Frontera de aislamiento de la ficha."
    },
    "empresa_nombre": {
      "type": "string",
      "description": "Nombre de la empresa (desnormalizado)"
    },
    "empresa_cif": {
      "type": "string",
      "description": "CIF de la empresa (desnormalizado)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "director_comercial"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            },
            {
              "user_condition": {
                "role": "administracion"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "director_comercial"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            },
            {
              "user_condition": {
                "role": "administracion"
              }
            },
            {
              "user_condition": {
                "role": "jefe_obra"
              }
            },
            {
              "user_condition": {
                "role": "t\u00e9cnico"
              }
            },
            {
              "data.user_email": "{{user.email}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "director_comercial"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            },
            {
              "user_condition": {
                "role": "administracion"
              }
            },
            {
              "user_condition": {
                "role": "jefe_obra"
              }
            },
            {
              "data.user_email": "{{user.email}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    }
  }
}