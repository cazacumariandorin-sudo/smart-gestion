{
  "name": "Operario",
  "type": "object",
  "properties": {
    "num_empleado": {
      "type": "string",
      "description": "N\u00famero de empleado \u00fanico \u2014 formato SMT-AAAA-NNNNN. Generado autom\u00e1ticamente al crear el t\u00e9cnico."
    },
    "name": {
      "type": "string",
      "description": "Nombre completo"
    },
    "dni": {
      "type": "string",
      "description": "DNI / NIE"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico personal"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono"
    },
    "role": {
      "type": "string",
      "description": "Puesto / categor\u00eda profesional"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Activo"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario de la app vinculado a este operario"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario de la app vinculado"
    },
    "user_vinculado_nombre": {
      "type": "string",
      "description": "Nombre display del usuario vinculado"
    },
    "vinculacion_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se realiz\u00f3 el v\u00ednculo con el usuario de la app"
    },
    "vinculacion_tipo": {
      "type": "string",
      "default": "sin_vincular",
      "enum": [
        "manual",
        "automatico_7dias",
        "demo",
        "sin_vincular"
      ],
      "description": "C\u00f3mo se realiz\u00f3 el v\u00ednculo"
    },
    "es_temporal": {
      "type": "boolean",
      "default": false,
      "description": "True si fue creado autom\u00e1ticamente por el sistema tras 7 d\u00edas sin vinculaci\u00f3n manual"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "oficial_primera",
        "oficial_segunda",
        "peon",
        "encargado",
        "tecnico_solar",
        "administrativo",
        "subcontrata",
        "temporal"
      ],
      "description": "Categor\u00eda profesional del trabajador"
    },
    "especialidad": {
      "type": "string",
      "description": "Especialidad t\u00e9cnica del trabajador (ej: instalaci\u00f3n fotovoltaica, electricidad, alba\u00f1iler\u00eda)"
    },
    "coste_hora": {
      "type": "number",
      "description": "Coste por hora en EUR (para c\u00e1lculo de rentabilidad de proyecto)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}