{
  "name": "Operario",
  "type": "object",
  "properties": {
    "num_empleado": {
      "type": "string",
      "description": "Número de empleado único — formato SMT-AAAA-NNNNN. Generado automáticamente al crear el técnico."
    },
    "name": {
      "type": "string",
      "description": "Nombre completo"
    },
    "dni": {
      "type": "string",
      "description": "DNI / NIE"
    },
    "email": {
      "type": "string",
      "description": "Correo electrónico personal"
    },
    "phone": {
      "type": "string",
      "description": "Teléfono"
    },
    "role": {
      "type": "string",
      "description": "Puesto / categoría profesional"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Activo"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario de la app vinculado a este operario"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario de la app vinculado"
    },
    "user_vinculado_nombre": {
      "type": "string",
      "description": "Nombre display del usuario vinculado"
    },
    "vinculacion_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se realizó el vínculo con el usuario de la app"
    },
    "vinculacion_tipo": {
      "type": "string",
      "default": "sin_vincular",
      "enum": [
        "manual",
        "automatico_7dias",
        "demo",
        "sin_vincular"
      ],
      "description": "Cómo se realizó el vínculo"
    },
    "es_temporal": {
      "type": "boolean",
      "default": false,
      "description": "True si fue creado automáticamente por el sistema tras 7 días sin vinculación manual"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "oficial_primera",
        "oficial_segunda",
        "peon",
        "encargado",
        "tecnico_solar",
        "administrativo",
        "subcontrata",
        "temporal"
      ],
      "description": "Categoría profesional del trabajador"
    },
    "especialidad": {
      "type": "string",
      "description": "Especialidad técnica del trabajador (ej: instalación fotovoltaica, electricidad, albañilería)"
    },
    "coste_hora": {
      "type": "number",
      "description": "Coste por hora en EUR (para cálculo de rentabilidad de proyecto)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID de la empresa (Entidad Empresa) a la que pertenece el empleado"
    },
    "empresa_nombre": {
      "type": "string",
      "description": "Nombre de la empresa (desnormalizado)"
    },
    "empresa_cif": {
      "type": "string",
      "description": "CIF de la empresa (desnormalizado)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
