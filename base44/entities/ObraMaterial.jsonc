{
  "name": "ObraMaterial",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID de la obra"
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "material",
        "herramienta",
        "maquinaria",
        "subcontrata",
        "transporte",
        "varios"
      ],
      "description": "Tipo de partida"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre / descripci\u00f3n del material"
    },
    "referencia": {
      "type": "string",
      "description": "Referencia o c\u00f3digo"
    },
    "proveedor": {
      "type": "string",
      "description": "Proveedor / suministrador"
    },
    "cantidad": {
      "type": "number",
      "description": "Cantidad"
    },
    "unidad": {
      "type": "string",
      "description": "Unidad (ud, m, m\u00b2, kg...)",
      "default": "ud"
    },
    "precio_unidad": {
      "type": "number",
      "description": "Precio unitario (\u20ac)"
    },
    "precio_total": {
      "type": "number",
      "description": "Precio total (\u20ac)"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del albar\u00e1n / factura"
    },
    "num_documento": {
      "type": "string",
      "description": "N\u00ba albar\u00e1n / factura / presupuesto"
    },
    "file_url": {
      "type": "string",
      "description": "URL del documento adjunto"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "obra_id",
    "nombre",
    "tipo"
  ]
}