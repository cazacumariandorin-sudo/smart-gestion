{
  "name": "ObraMaterial",
  "type": "object",
  "properties": {
    "cantidad": {
      "type": "number"
    },
    "fecha": {
      "format": "date",
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "num_documento": {
      "type": "string"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "precio_total": {
      "type": "number"
    },
    "precio_unidad": {
      "type": "number"
    },
    "proveedor": {
      "type": "string"
    },
    "referencia": {
      "type": "string"
    },
    "tipo": {
      "enum": [
        "material",
        "herramienta",
        "maquinaria",
        "subcontrata",
        "transporte",
        "varios"
      ],
      "type": "string"
    },
    "unidad": {
      "default": "ud",
      "type": "string"
    }
  },
  "required": [
    "obra_id",
    "nombre",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}