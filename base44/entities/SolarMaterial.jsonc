{
  "name": "SolarMaterial",
  "type": "object",
  "properties": {
    "categoria": {
      "enum": [
        "panel",
        "inversor",
        "bateria",
        "estructura",
        "cableado",
        "protecciones",
        "monitor",
        "otros"
      ],
      "type": "string"
    },
    "marca": {
      "type": "string"
    },
    "modelo": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "potencia_w": {
      "type": "number"
    },
    "stock": {
      "type": "number"
    },
    "unit": {
      "default": "ud",
      "type": "string"
    },
    "unit_price": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "categoria"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}