{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "jefe_obra",
        "operario",
        "control_horario"
      ],
      "default": "operario",
      "description": "Tipo de usuario"
    },
    "operario_id": {
      "type": "string",
      "description": "ID del operario vinculado (para rol operario)"
    },
    "acceso_total_hasta": {
      "type": "string",
      "format": "date",
      "description": "Fecha hasta la que tiene acceso completo temporal (admin puede conceder)"
    }
  }
}