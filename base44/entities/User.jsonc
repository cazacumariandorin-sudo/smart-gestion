{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "gerencia",
        "director_comercial",
        "jefe_obra",
        "operario",
        "control_horario",
        "cliente_obra",
        "usuario_demo"
      ],
      "default": "operario",
      "description": "Rol del usuario en la aplicaci\u00f3n"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo o posici\u00f3n del usuario en la empresa"
    },
    "acceso_hasta": {
      "type": "string",
      "format": "date",
      "description": "Fecha l\u00edmite de acceso del usuario"
    },
    "tipo_cuenta": {
      "type": "string",
      "enum": [
        "real",
        "demo"
      ],
      "default": "real",
      "description": "Clase de cuenta: real (usuario de empresa) o demo"
    },
    "demo_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha/hora de expiraci\u00f3n del acceso demo"
    },
    "invitado_por": {
      "type": "string",
      "description": "Email del usuario que gener\u00f3 la invitaci\u00f3n demo"
    },
    "vinculo_id": {
      "type": "string",
      "description": "ID del cliente vinculado a este usuario para rol cliente_obra"
    }
  },
  "required": []
}