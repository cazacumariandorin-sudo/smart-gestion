{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "gerencia",
        "director_comercial",
        "t\u00e9cnico",
        "jefe_obra",
        "operario",
        "control_horario",
        "cliente_obra",
        "usuario_demo",
        "propietario",
        "contabilidad",
        "administracion"
      ],
      "default": "operario",
      "description": "Rol de acceso al sistema"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo o puesto visible"
    },
    "avatar_initials": {
      "type": "string",
      "description": "Iniciales del avatar"
    },
    "tipo_cuenta": {
      "type": "string",
      "enum": [
        "real",
        "demo"
      ],
      "default": "real"
    },
    "estado_cuenta": {
      "type": "string",
      "enum": [
        "activo",
        "inactivo",
        "pendiente_activacion",
        "suspendido"
      ],
      "default": "pendiente_activacion",
      "description": "Estado del ciclo de vida de la cuenta: pendiente_activacion (invitaci\u00f3n enviada), activo (invitaci\u00f3n aceptada), inactivo (sin acceso voluntario), suspendido (sanci\u00f3n / bloqueo temporal)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID de la empresa (entidad Empresa) a la que pertenece como empleado"
    },
    "empresa_nombre": {
      "type": "string",
      "description": "Nombre de la empresa (desnormalizado)"
    },
    "fecha_vinculacion_empresa": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el usuario qued\u00f3 vinculado a la empresa como empleado"
    },
    "acceso_hasta": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de expiraci\u00f3n del acceso. Para demos: caducidad de la cuenta. Para rol contabilidad (gestor\u00eda externa): fin del contrato por temporada fiscal. ProtectedRoute rechaza el acceso si acceso_hasta < hoy."
    },
    "invitado_por": {
      "type": "string",
      "description": "Email del usuario que invit\u00f3"
    },
    "suspendido_por": {
      "type": "string",
      "description": "Email del gerente/admin que suspendi\u00f3 la cuenta"
    },
    "fecha_suspension": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se suspendi\u00f3 la cuenta"
    },
    "motivo_suspension": {
      "type": "string",
      "description": "Motivo de la suspensi\u00f3n de la cuenta"
    },
    "vinculo_estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "vinculado",
        "auto_vinculado",
        "demo"
      ],
      "description": "Estado de vinculaci\u00f3n con ficha laboral"
    },
    "vinculo_id": {
      "type": "string",
      "description": "ID de la ficha Operario vinculada"
    },
    "vinculo_nombre": {
      "type": "string",
      "description": "Nombre del operario vinculado"
    },
    "vinculo_tipo": {
      "type": "string",
      "description": "Tipo de vinculaci\u00f3n"
    },
    "user_id_personalizado": {
      "type": "string",
      "description": "ID personalizado del usuario"
    },
    "demo_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de expiraci\u00f3n de la cuenta demo"
    },
    "onboarding_completado": {
      "type": "boolean",
      "default": false,
      "description": "El usuario ha completado el modal de bienvenida y tiene nombre configurado"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}