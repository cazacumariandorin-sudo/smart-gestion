{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "gerencia",
        "director_comercial",
        "jefe_obra",
        "operario",
        "control_horario",
        "cliente_obra"
      ],
      "default": "operario",
      "description": "Rol del usuario en la aplicaci\u00f3n"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo o posici\u00f3n del usuario en la empresa"
    },
    "acceso_hasta": {
      "type": "string",
      "format": "date",
      "description": "Fecha l\u00edmite de acceso del usuario"
    }
  },
  "required": [
    "cargo",
    "acceso_hasta"
  ]
}