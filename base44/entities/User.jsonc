{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "gerencia",
        "director_comercial",
        "jefe_obra",
        "operario",
        "control_horario",
        "cliente_obra",
        "usuario_demo"
      ],
      "default": "operario",
      "description": "Rol de acceso al sistema"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo o puesto visible"
    },
    "avatar_initials": {
      "type": "string",
      "description": "Iniciales del avatar"
    },
    "tipo_cuenta": {
      "type": "string",
      "enum": [
        "real",
        "demo"
      ],
      "default": "real"
    },
    "acceso_hasta": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de expiraci\u00f3n del acceso (solo para demos)"
    },
    "invitado_por": {
      "type": "string",
      "description": "Email del usuario que invit\u00f3"
    },
    "vinculo_estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "vinculado",
        "auto_vinculado",
        "demo"
      ],
      "description": "Estado de vinculaci\u00f3n con ficha laboral"
    },
    "vinculo_id": {
      "type": "string",
      "description": "ID de la ficha Operario vinculada"
    },
    "vinculo_nombre": {
      "type": "string",
      "description": "Nombre del operario vinculado"
    },
    "vinculo_tipo": {
      "type": "string",
      "description": "Tipo de vinculaci\u00f3n"
    },
    "user_id_personalizado": {
      "type": "string",
      "description": "ID personalizado del usuario"
    },
    "demo_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de expiraci\u00f3n de la cuenta demo"
    },
    "onboarding_completado": {
      "type": "boolean",
      "default": false,
      "description": "El usuario ha completado el modal de bienvenida y tiene nombre configurado"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}