{
  "name": "DiagnosticoAcceso",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email del usuario autorizado a acceder al m\u00f3dulo de Diagn\u00f3stico (IT externo)"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario (si se vincula)"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre descriptivo del autorizado"
    },
    "rol_asignado": {
      "type": "string",
      "enum": [
        "soporte_it",
        "tecnico_it",
        "auditor_externo",
        "consultor"
      ],
      "default": "tecnico_it",
      "description": "Rol funcional del autorizado en el m\u00f3dulo de diagn\u00f3stico"
    },
    "autorizado_por": {
      "type": "string",
      "description": "Email del gerente que autoriz\u00f3 el acceso"
    },
    "fecha_autorizacion": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_expiracion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha opcional de expiraci\u00f3n del acceso"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el acceso est\u00e1 activo"
    },
    "notas": {
      "type": "string",
      "description": "Notas de la autorizaci\u00f3n"
    }
  },
  "required": [
    "user_email",
    "rol_asignado"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    }
  }
}