{
  "name": "Herramienta",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre de la herramienta"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "escalera",
        "taladro",
        "atornillador",
        "radial",
        "maquina_tiros",
        "otros"
      ],
      "description": "Categoría de la herramienta"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo o referencia"
    },
    "numero_serie": {
      "type": "string",
      "description": "Número de serie (único)"
    },
    "estado": {
      "type": "string",
      "enum": [
        "disponible",
        "en_uso",
        "mantenimiento",
        "baja"
      ],
      "default": "disponible",
      "description": "Estado actual"
    },
    "valor_compra": {
      "type": "number",
      "description": "Valor de compra (€)"
    },
    "fecha_compra": {
      "type": "string",
      "format": "date",
      "description": "Fecha de compra"
    },
    "ubicacion": {
      "type": "string",
      "description": "Ubicación física (almacén, obra, etc.)"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "nombre",
    "categoria"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
