{
  "name": "DatosSensiblesCliente",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente relacionado"
    },
    "cliente_nombre": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "numero_cuenta_bancaria": {
      "type": "string",
      "description": "IBAN o número de cuenta para transferencias — almacenado cifrado (AES-256-GCM)"
    },
    "datos_fiscales": {
      "type": "string",
      "description": "Información fiscal sensible (domicilio fiscal, etc.) — almacenado cifrado (AES-256-GCM)"
    },
    "contacto_principal_personal": {
      "type": "string",
      "description": "Teléfono/email personal del contacto principal — almacenado cifrado (AES-256-GCM)"
    },
    "precio_especial": {
      "type": "string",
      "description": "Descuento o precio especial negociado — almacenado cifrado (AES-256-GCM)"
    },
    "condiciones_pago": {
      "type": "string",
      "description": "Condiciones de pago personalizadas"
    },
    "notas_confidenciales": {
      "type": "string",
      "description": "Notas internas sobre el cliente — almacenado cifrado (AES-256-GCM)"
    }
  },
  "required": [
    "cliente_id",
    "cliente_nombre"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
