{
  "name": "Order",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo del pedido"
    },
    "obra_id": {
      "type": "string",
      "description": "ID de la obra"
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "proveedor": {
      "type": "string",
      "description": "Proveedor"
    },
    "fecha_pedido": {
      "type": "string",
      "format": "date",
      "description": "Fecha del pedido"
    },
    "fecha_entrega": {
      "type": "string",
      "format": "date",
      "description": "Fecha de entrega prevista"
    },
    "importe": {
      "type": "number",
      "description": "Importe total (\u20ac)"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_curso",
        "entregado",
        "cancelado"
      ],
      "default": "pendiente",
      "description": "Estado del pedido"
    },
    "items": {
      "type": "array",
      "description": "L\u00edneas del pedido",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "unidad": {
            "type": "string"
          },
          "precio": {
            "type": "number"
          }
        }
      }
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    },
    "file_url": {
      "type": "string",
      "description": "Adjunto (albar\u00e1n, factura...)"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "operario"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}