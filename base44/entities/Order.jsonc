{
  "name": "Order",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "date": {
      "format": "date",
      "type": "string",
      "description": "Fecha del pedido"
    },
    "expected_delivery": {
      "format": "date",
      "type": "string",
      "description": "Fecha de entrega prevista"
    },
    "items": {
      "items": {
        "properties": {
          "material_id": {
            "type": "string"
          },
          "material_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array",
      "description": "L\u00edneas del pedido"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero de pedido"
    },
    "proyecto": {
      "type": "string",
      "description": "Proyecto (antes: Obra)"
    },
    "status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "confirmado",
        "en_transito",
        "entregado",
        "cancelado"
      ],
      "type": "string",
      "description": "Estado del pedido"
    },
    "supplier": {
      "type": "string",
      "description": "Proveedor"
    },
    "total_amount": {
      "type": "number",
      "description": "Importe total (\u20ac)"
    },
    "tracking_number": {
      "type": "string",
      "description": "N\u00famero de seguimiento"
    }
  },
  "required": [
    "client_id",
    "proyecto",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}