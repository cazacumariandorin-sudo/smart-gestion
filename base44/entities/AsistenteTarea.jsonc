{
  "name": "AsistenteTarea",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "recordatorio",
        "comprobacion",
        "alerta",
        "tarea_manual",
        "informe",
        "nota_interna",
        "nota_privada"
      ]
    },
    "prioridad": {
      "type": "string",
      "default": "media",
      "enum": [
        "baja",
        "media",
        "alta",
        "urgente"
      ]
    },
    "estado": {
      "type": "string",
      "default": "pendiente",
      "enum": [
        "pendiente",
        "en_curso",
        "completada",
        "descartada"
      ]
    },
    "asignada_a_user_id": {
      "type": "string",
      "description": "ID del usuario al que va la tarea"
    },
    "asignada_a_nombre": {
      "type": "string"
    },
    "asignada_a_rol": {
      "type": "string"
    },
    "fecha_limite": {
      "type": "string",
      "format": "date"
    },
    "fecha_completada": {
      "type": "string",
      "format": "date-time"
    },
    "recordatorio_fecha": {
      "type": "string",
      "format": "date-time"
    },
    "entidad_relacionada_tipo": {
      "type": "string",
      "description": "Obra, WorkOrder, Fichaje, Vehiculo..."
    },
    "entidad_relacionada_id": {
      "type": "string"
    },
    "contexto_ia": {
      "type": "string",
      "description": "Razonamiento del asistente que generó la tarea"
    },
    "creada_por": {
      "type": "string",
      "default": "asistente_ia",
      "enum": [
        "asistente_ia",
        "usuario",
        "sistema"
      ]
    },
    "feedback_usuario": {
      "type": "string"
    },
    "solo_gerencia": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, solo visible para admin, gerencia y director_comercial"
    },
    "modulo": {
      "type": "string",
      "description": "Módulo del dashboard al que pertenece: obras, personas, economico, flota, nominas, sistema..."
    },
    "origen_solicitud": {
      "type": "string",
      "description": "Nombre o email del trabajador/cliente que originó la solicitud"
    }
  },
  "required": [
    "titulo",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "jefe_obra"
              }
            },
            {
              "data.solo_gerencia": false
            }
          ]
        },
        {
          "$and": [
            {
              "data.asignada_a_user_id": "{{user.id}}"
            },
            {
              "data.solo_gerencia": false
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "data.asignada_a_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    }
  }
}
