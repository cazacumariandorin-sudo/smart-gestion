{
  "name": "DiagnosticoSesion",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email del usuario que reportó / sufrió el error"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario"
    },
    "user_role": {
      "type": "string",
      "description": "Rol del usuario (admin, gerencia, técnico, operario...)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "error_auto",
        "pantalla_blanca",
        "reporte_manual",
        "timeout_red",
        "crash_js",
        "rechazo_promesa"
      ],
      "default": "error_auto",
      "description": "Tipo de incidente diagnosticado"
    },
    "severidad": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "critico"
      ],
      "default": "error"
    },
    "mensaje_error": {
      "type": "string",
      "description": "Mensaje técnico del error / excepción"
    },
    "stack_trace": {
      "type": "string",
      "description": "Traza completa del error (primeras N líneas)"
    },
    "ruta": {
      "type": "string",
      "description": "window.location.pathname donde ocurrió"
    },
    "ruta_completa": {
      "type": "string",
      "description": "window.location.href completa"
    },
    "user_agent": {
      "type": "string",
      "description": "User-Agent completo del navegador / dispositivo"
    },
    "navegador": {
      "type": "string",
      "description": "Navegador parseado (Chrome, Safari...)"
    },
    "sistema_operativo": {
      "type": "string",
      "description": "SO parseado (Android 12, iOS 17...)"
    },
    "dispositivo_modelo": {
      "type": "string",
      "description": "Modelo de dispositivo si se puede detectar"
    },
    "resolucion_pantalla": {
      "type": "string",
      "description": "Resolución de pantalla (ancho x alto)"
    },
    "viewport": {
      "type": "string",
      "description": "Tamaño del viewport (ancho x alto)"
    },
    "nivel_bateria": {
      "type": "number",
      "description": "Nivel de batería (0-1) si está disponible"
    },
    "cargando_bateria": {
      "type": "boolean",
      "description": "Si el dispositivo está cargando"
    },
    "calidad_red": {
      "type": "string",
      "description": "Tipo de conexión efectiva (4g, 3g, 2g, slow-2g)"
    },
    "downlink_mbps": {
      "type": "number",
      "description": "Velocidad de bajada estimada (Mbps)"
    },
    "rtt_ms": {
      "type": "number",
      "description": "Round-trip time (ms)"
    },
    "online": {
      "type": "boolean",
      "description": "Si el navegador reporta estar online"
    },
    "ultima_accion": {
      "type": "string",
      "description": "Última acción registrada antes del fallo"
    },
    "historial_navegacion": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Últimas rutas visitadas antes del error"
    },
    "notas_usuario": {
      "type": "string",
      "description": "Descripción del fallo escrita por el usuario (en reportes manuales)"
    },
    "pasos_reproducir": {
      "type": "string",
      "description": "Pasos para reproducir (en reportes manuales)"
    },
    "cookies_habilitadas": {
      "type": "boolean",
      "description": "Si las cookies están habilitadas en el navegador"
    },
    "memoria_uso_mb": {
      "type": "number",
      "description": "Memoria usada (MB) si performance.memory está disponible"
    },
    "estado": {
      "type": "string",
      "enum": [
        "nuevo",
        "revisado",
        "en_proceso",
        "resuelto",
        "ignorado"
      ],
      "default": "nuevo",
      "description": "Estado de triaje del incidente"
    },
    "comentario_soporte": {
      "type": "string",
      "description": "Notas internas del equipo de soporte/IT"
    },
    "revisado_por": {
      "type": "string",
      "description": "Email del responsable que revisó el incidente"
    },
    "fecha_revision": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "tipo",
    "ruta"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    }
  }
}
