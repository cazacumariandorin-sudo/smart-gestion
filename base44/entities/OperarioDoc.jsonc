{
  "name": "OperarioDoc",
  "type": "object",
  "properties": {
    "operario_id": {
      "type": "string",
      "description": "ID del operario"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario"
    },
    "obra_id": {
      "type": "string",
      "description": "ID de la obra (si aplica)"
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "doc_operario",
        "doc_obra",
        "doc_empresa"
      ],
      "default": "doc_operario",
      "description": "Tipo: doc_operario=propio operario, doc_obra=documentaci\u00f3n de obra, doc_empresa=documento empresa para firmar"
    },
    "categoria": {
      "type": "string",
      "description": "Categor\u00eda del documento"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo del documento"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del documento"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de caducidad"
    },
    "file_url": {
      "type": "string",
      "description": "URL del archivo"
    },
    "firma_url": {
      "type": "string",
      "description": "URL imagen firma del operario"
    },
    "fecha_firma": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que fue firmado"
    },
    "firmado": {
      "type": "boolean",
      "default": false,
      "description": "Si el operario ha firmado el documento"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "operario_id",
    "tipo",
    "title"
  ]
}