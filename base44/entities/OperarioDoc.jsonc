{
  "name": "OperarioDoc",
  "properties": {
    "categoria": {
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "expiry_date": {
      "format": "date",
      "type": "string"
    },
    "fecha_firma": {
      "format": "date",
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "firma_url": {
      "type": "string"
    },
    "firmado": {
      "default": false,
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "tipo": {
      "default": "doc_operario",
      "enum": [
        "doc_operario",
        "doc_obra",
        "doc_empresa"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "operario_id",
    "tipo",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "data.operario_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "data.operario_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}