{
  "name": "Vehiculo",
  "type": "object",
  "properties": {
    "matricula": {
      "type": "string",
      "description": "Matr\u00edcula del veh\u00edculo"
    },
    "modelo": {
      "type": "string",
      "description": "Marca y modelo"
    },
    "anio": {
      "type": "integer",
      "description": "A\u00f1o"
    },
    "color": {
      "type": "string",
      "description": "Color"
    },
    "asignado_a": {
      "type": "string",
      "description": "Nombre del operario/conductor asignado"
    },
    "asignado_id": {
      "type": "string",
      "description": "ID del operario asignado"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones generales"
    },
    "itv_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha caducidad ITV"
    },
    "neumaticos_km": {
      "type": "number",
      "description": "Km en \u00faltimo cambio neum\u00e1ticos"
    },
    "neumaticos_km_cambio": {
      "type": "number",
      "description": "Km previstos pr\u00f3ximo cambio"
    },
    "neumaticos_fecha_ultimo": {
      "type": "string",
      "format": "date",
      "description": "Fecha \u00faltimo cambio neum\u00e1ticos"
    },
    "aceite_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha pr\u00f3ximo cambio aceite"
    },
    "aceite_km": {
      "type": "number",
      "description": "Km pr\u00f3ximo cambio aceite"
    },
    "filtros_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha pr\u00f3ximo cambio filtros"
    },
    "filtros_km": {
      "type": "number",
      "description": "Km pr\u00f3ximo cambio filtros"
    },
    "ac_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha revisi\u00f3n aire acondicionado"
    },
    "km_actuales": {
      "type": "number",
      "description": "Km actuales del veh\u00edculo"
    },
    "alertas_email": {
      "type": "string",
      "description": "Emails para alertas (separados por coma)"
    },
    "alertas_activas": {
      "type": "boolean",
      "default": true,
      "description": "Activar alertas por email"
    },
    "telematica_id": {
      "type": "string",
      "description": "ID del veh\u00edculo en sistema telem\u00e1tico"
    },
    "telematica_proveedor": {
      "type": "string",
      "enum": [
        "geotab",
        "verizon",
        "manual",
        "otro"
      ],
      "default": "manual",
      "description": "Proveedor de telem\u00e1tica"
    },
    "telematica_activa": {
      "type": "boolean",
      "default": false,
      "description": "Si tiene telem\u00e1tica conectada"
    },
    "ultima_posicion_lat": {
      "type": "number",
      "description": "\u00daltima latitud conocida"
    },
    "ultima_posicion_lng": {
      "type": "number",
      "description": "\u00daltima longitud conocida"
    },
    "ultima_posicion_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha/hora \u00faltima posici\u00f3n"
    },
    "ultima_posicion_direccion": {
      "type": "string",
      "description": "Direcci\u00f3n aproximada \u00faltima posici\u00f3n"
    },
    "km_mes_actual": {
      "type": "number",
      "description": "Km acumulados en el mes en curso"
    },
    "consumo_medio_l100": {
      "type": "number",
      "description": "Consumo medio L/100km"
    },
    "estado_motor": {
      "type": "string",
      "enum": [
        "en_marcha",
        "parado",
        "desconocido"
      ],
      "default": "desconocido",
      "description": "Estado actual del motor"
    },
    "velocidad_actual": {
      "type": "number",
      "description": "Velocidad actual km/h"
    },
    "proyecto_actual_id": {
      "type": "string",
      "description": "ID del proyecto al que est\u00e1 asignado hoy"
    },
    "proyecto_actual_nombre": {
      "type": "string",
      "description": "Nombre del proyecto actual"
    }
  },
  "required": [
    "matricula",
    "modelo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}