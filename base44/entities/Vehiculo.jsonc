{
  "name": "Vehiculo",
  "type": "object",
  "properties": {
    "matricula": {
      "type": "string",
      "description": "Matr\u00edcula del veh\u00edculo"
    },
    "modelo": {
      "type": "string",
      "description": "Marca y modelo"
    },
    "anio": {
      "type": "integer",
      "description": "A\u00f1o"
    },
    "color": {
      "type": "string",
      "description": "Color"
    },
    "asignado_a": {
      "type": "string",
      "description": "Nombre del operario/conductor asignado"
    },
    "asignado_id": {
      "type": "string",
      "description": "ID del operario asignado"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones generales"
    },
    "itv_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha caducidad ITV"
    },
    "neumaticos_km": {
      "type": "number"
    },
    "neumaticos_km_cambio": {
      "type": "number"
    },
    "neumaticos_fecha_ultimo": {
      "type": "string",
      "format": "date"
    },
    "aceite_fecha": {
      "type": "string",
      "format": "date"
    },
    "aceite_km": {
      "type": "number"
    },
    "filtros_fecha": {
      "type": "string",
      "format": "date"
    },
    "filtros_km": {
      "type": "number"
    },
    "ac_fecha": {
      "type": "string",
      "format": "date"
    },
    "km_actuales": {
      "type": "number"
    },
    "alertas_email": {
      "type": "string"
    },
    "alertas_activas": {
      "type": "boolean",
      "default": true
    },
    "telematica_id": {
      "type": "string"
    },
    "telematica_proveedor": {
      "type": "string",
      "enum": [
        "geotab",
        "verizon",
        "manual",
        "otro"
      ],
      "default": "manual"
    },
    "telematica_activa": {
      "type": "boolean",
      "default": false
    },
    "ultima_posicion_lat": {
      "type": "number"
    },
    "ultima_posicion_lng": {
      "type": "number"
    },
    "ultima_posicion_fecha": {
      "type": "string",
      "format": "date-time"
    },
    "ultima_posicion_direccion": {
      "type": "string"
    },
    "km_mes_actual": {
      "type": "number"
    },
    "consumo_medio_l100": {
      "type": "number"
    },
    "estado_motor": {
      "type": "string",
      "enum": [
        "en_marcha",
        "parado",
        "desconocido"
      ],
      "default": "desconocido"
    },
    "velocidad_actual": {
      "type": "number"
    },
    "proyecto_actual_id": {
      "type": "string"
    },
    "proyecto_actual_nombre": {
      "type": "string"
    }
  },
  "required": [
    "matricula",
    "modelo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}