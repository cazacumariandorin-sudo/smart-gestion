{
  "name": "Vehiculo",
  "type": "object",
  "properties": {
    "matricula": {
      "type": "string",
      "description": "Matr\u00edcula del veh\u00edculo"
    },
    "modelo": {
      "type": "string",
      "description": "Marca y modelo"
    },
    "anio": {
      "type": "integer",
      "description": "A\u00f1o"
    },
    "color": {
      "type": "string",
      "description": "Color"
    },
    "asignado_a": {
      "type": "string",
      "description": "Nombre del operario/conductor asignado"
    },
    "asignado_id": {
      "type": "string",
      "description": "ID del operario asignado"
    },
    "clasificacion": {
      "type": "string",
      "enum": [
        "empresa",
        "oficial"
      ],
      "default": "empresa",
      "description": "Clasificaci\u00f3n de acceso definida por gerencia. empresa = visible para t\u00e9cnicos/jefe de obra; oficial = solo gerencia/administraci\u00f3n/director comercial."
    },
    "notas": {
      "type": "string",
      "description": "Observaciones generales"
    },
    "documentos": {
      "type": "array",
      "description": "Documentaci\u00f3n del veh\u00edculo (permiso de circulaci\u00f3n, ficha t\u00e9cnica, seguro, ITV...). Almacenados con URL P\u00daBLICA permanente para poder compartir con terceros (talleres, proveedores, autoridades) sin necesidad de login.",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "permiso_circulacion",
              "ficha_tecnica",
              "seguro",
              "itv",
              "otro"
            ],
            "description": "Tipo de documento del veh\u00edculo"
          },
          "url": {
            "type": "string",
            "description": "URL p\u00fablica permanente del archivo (UploadPublicFile). Cualquiera con el enlace puede acceder."
          },
          "nombre": {
            "type": "string",
            "description": "Nombre original del archivo"
          },
          "fecha_subida": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp de subida"
          },
          "subido_por": {
            "type": "string",
            "description": "Email de quien subi\u00f3 el documento"
          }
        }
      }
    },
    "itv_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha caducidad ITV"
    },
    "neumaticos_km": {
      "type": "number"
    },
    "neumaticos_km_cambio": {
      "type": "number"
    },
    "neumaticos_fecha_ultimo": {
      "type": "string",
      "format": "date"
    },
    "aceite_fecha": {
      "type": "string",
      "format": "date"
    },
    "aceite_km": {
      "type": "number"
    },
    "filtros_fecha": {
      "type": "string",
      "format": "date"
    },
    "filtros_km": {
      "type": "number"
    },
    "ac_fecha": {
      "type": "string",
      "format": "date"
    },
    "km_actuales": {
      "type": "number"
    },
    "alertas_email": {
      "type": "string"
    },
    "alertas_activas": {
      "type": "boolean",
      "default": true
    },
    "telematica_id": {
      "type": "string"
    },
    "telematica_proveedor": {
      "type": "string",
      "enum": [
        "geotab",
        "verizon",
        "manual",
        "otro"
      ],
      "default": "manual"
    },
    "telematica_activa": {
      "type": "boolean",
      "default": false
    },
    "ultima_posicion_lat": {
      "type": "number"
    },
    "ultima_posicion_lng": {
      "type": "number"
    },
    "ultima_posicion_fecha": {
      "type": "string",
      "format": "date-time"
    },
    "ultima_posicion_direccion": {
      "type": "string"
    },
    "km_mes_actual": {
      "type": "number"
    },
    "consumo_medio_l100": {
      "type": "number"
    },
    "estado_motor": {
      "type": "string",
      "enum": [
        "en_marcha",
        "parado",
        "desconocido"
      ],
      "default": "desconocido"
    },
    "velocidad_actual": {
      "type": "number"
    },
    "proyecto_actual_id": {
      "type": "string"
    },
    "proyecto_actual_nombre": {
      "type": "string"
    }
  },
  "required": [
    "matricula",
    "modelo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "data.clasificacion": "empresa"
                },
                {
                  "data.clasificacion": {
                    "$exists": false
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "jefe_obra"
                  }
                },
                {
                  "user_condition": {
                    "role": "t\u00e9cnico"
                  }
                },
                {
                  "user_condition": {
                    "role": "operario"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}