{
  "name": "AlarmaHorario",
  "type": "object",
  "properties": {
    "activa": {
      "default": true,
      "type": "boolean"
    },
    "dias": {
      "items": {
        "type": "number"
      },
      "type": "array"
    },
    "hora": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "sonido": {
      "default": "default",
      "type": "string"
    },
    "tipo": {
      "enum": [
        "entrada",
        "salida",
        "pausa_inicio",
        "pausa_fin"
      ],
      "type": "string"
    }
  },
  "required": [
    "nombre",
    "hora",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    }
  }
}