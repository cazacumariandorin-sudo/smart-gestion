{
  "name": "ChatMensaje",
  "type": "object",
  "properties": {
    "adjuntos": {
      "items": {
        "properties": {
          "nombre": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number"
          },
          "tipo": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "algoritmo": {
      "default": "AES-256-GCM",
      "type": "string"
    },
    "autor_avatar": {
      "type": "string"
    },
    "autor_email": {
      "type": "string"
    },
    "autor_nombre": {
      "type": "string"
    },
    "autor_rol": {
      "type": "string"
    },
    "cifrado_tipo": {
      "default": "ninguno",
      "enum": [
        "ninguno",
        "AES-256-GCM",
        "RSA-OAEP"
      ],
      "type": "string"
    },
    "conversacion_id": {
      "type": "string"
    },
    "destinatarios": {
      "type": "array",
      "description": "Emails de los participantes de la conversaci\u00f3n en el momento del env\u00edo",
      "items": {
        "type": "string"
      }
    },
    "editado": {
      "default": false,
      "type": "boolean"
    },
    "fecha_edicion": {
      "format": "date-time",
      "type": "string"
    },
    "fecha_envio": {
      "format": "date-time",
      "type": "string"
    },
    "iv": {
      "type": "string"
    },
    "leido_por": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "menciones": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "mensaje_cifrado": {
      "type": "string"
    },
    "obra_id": {
      "type": "string"
    },
    "parte_id": {
      "type": "string"
    },
    "reply_a_id": {
      "type": "string"
    },
    "reply_preview": {
      "type": "string"
    },
    "tipo_mensaje": {
      "default": "texto",
      "enum": [
        "texto",
        "imagen",
        "archivo",
        "sistema",
        "reply",
        "cifrado"
      ],
      "type": "string"
    }
  },
  "required": [
    "conversacion_id",
    "autor_email",
    "mensaje_cifrado",
    "iv"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.destinatarios": {
            "$elemMatch": {
              "$eq": "{{user.email}}"
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}