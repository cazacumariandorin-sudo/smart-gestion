{
  "name": "Nomina",
  "type": "object",
  "properties": {
    "operario_id": {
      "type": "string",
      "description": "ID del operario vinculado"
    },
    "operario_user_email": {
      "type": "string",
      "description": "Email del usuario de la app vinculado al operario (para RLS y filtros r\u00e1pidos)"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario"
    },
    "operario_dni": {
      "type": "string",
      "description": "DNI del operario"
    },
    "mes": {
      "type": "integer",
      "description": "Mes (1-12)"
    },
    "anio": {
      "type": "integer",
      "description": "A\u00f1o"
    },
    "periodo": {
      "type": "string",
      "description": "Ej: Julio 2026"
    },
    "file_url": {
      "type": "string",
      "description": "URL del PDF"
    },
    "drive_file_id": {
      "type": "string",
      "description": "ID del archivo en Google Drive"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "nomina_individual",
        "resumen_costes"
      ],
      "default": "nomina_individual",
      "description": "Tipo de documento: n\u00f3mina individual o resumen GEFISCAL"
    },
    "liquido_percibir": {
      "type": "number"
    },
    "total_devengado": {
      "type": "number"
    },
    "prorrata_pagas_extra": {
      "type": "number"
    },
    "cuotas_obreras": {
      "type": "number",
      "description": "Cuotas obreras (SS trabajador)"
    },
    "retencion_irpf": {
      "type": "number"
    },
    "coste_ss_empresa": {
      "type": "number"
    },
    "coste_empresa": {
      "type": "number"
    },
    "anticipos_deducciones": {
      "type": "number"
    },
    "tipo_anticipo": {
      "type": "string"
    },
    "estado_asignacion": {
      "type": "string",
      "enum": [
        "asignada",
        "sin_asignar",
        "revision_manual"
      ],
      "default": "asignada"
    },
    "importe_pagado": {
      "type": "number",
      "default": 0,
      "description": "Suma de los justificantes de pago (JustificanteNomina) de esta n\u00f3mina. Se recalcula al subir o bajar justificantes."
    },
    "estado_pago": {
      "type": "string",
      "enum": [
        "pendiente",
        "parcial",
        "pagado"
      ],
      "default": "pendiente",
      "description": "pendiente = sin justificantes; parcial = pagada en parte, a\u00fan falta importe; pagado = cobrada por completo, ciclo de pago cerrado."
    },
    "lote_id": {
      "type": "string"
    },
    "pagina_origen": {
      "type": "integer"
    },
    "texto_extraido": {
      "type": "string"
    }
  },
  "required": [
    "mes",
    "anio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "data.operario_user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}