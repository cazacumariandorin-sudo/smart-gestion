{
  "name": "MaterialPrecioHistorico",
  "type": "object",
  "properties": {
    "material_id": {
      "type": "string",
      "description": "ID del MaterialCatalog al que pertenece este precio hist\u00f3rico. Opcional: si la tarifa es un CONCEPTO DE OBRA (INSTAL_ELEC_01, instalaci\u00f3n por punto) y no un producto de cat\u00e1logo, se deja vac\u00edo y se usa referencia_concepto."
    },
    "material_referencia": {
      "type": "string",
      "description": "Referencia del material de cat\u00e1logo (denormalizada para filtros y matching OCR). Vac\u00edo si es concepto de obra."
    },
    "referencia_concepto": {
      "type": "string",
      "description": "Referencia del CONCEPTO DE OBRA (INSTAL_ELEC_01, INSTAL_ELEC_04) cuando la tarifa es por concepto y no por material de cat\u00e1logo. Distinto de material_referencia. Un registro puede tener material_id (producto) O referencia_concepto (concepto), no ambos."
    },
    "fabricante_id": {
      "type": "string",
      "description": "ID del Fabricante"
    },
    "fabricante_name": {
      "type": "string",
      "description": "Nombre del fabricante (denormalizado para mostrar)"
    },
    "fecha_documento": {
      "type": "string",
      "format": "date",
      "description": "Fecha del documento que origin\u00f3 este precio"
    },
    "fecha_efectiva": {
      "type": "string",
      "format": "date",
      "description": "Fecha a partir de la cual aplica el precio (por defecto la del documento)"
    },
    "pvp": {
      "type": "number",
      "description": "PVP p\u00fablico de venta (si figura en el documento)"
    },
    "descuento_empresa": {
      "type": "number",
      "description": "% descuento aplicado a Simantec (si figura o se deduce)"
    },
    "iva": {
      "type": "number",
      "description": "% IVA aplicado a la l\u00ednea"
    },
    "precio_neto": {
      "type": "number",
      "description": "Precio realmente pagado por unidad (con descuento incluido, sin IVA)"
    },
    "unidad_tarifa": {
      "type": "string",
      "enum": [
        "por_punto",
        "por_metro",
        "por_unidad"
      ],
      "description": "Unidad de la TARIFA (concepto de obra), distinta de la unidad de material: por_punto (78.50\u20ac/punto BMS), por_metro (6.58\u20ac/m de cable), por_unidad (unidades de producto de cat\u00e1logo). Clave para la conciliaci\u00f3n: determina si se compara contra recuento de ItemLista (por_punto) o contra distancia (por_metro)."
    },
    "precio_anterior": {
      "type": "number",
      "description": "\u00daltimo precio_neto guardado para ese material/concepto (denormalizado para ver el salto)"
    },
    "variacion_pct": {
      "type": "number",
      "description": "((precio_nuevo - precio_anterior) / precio_anterior) * 100. null = primer registro"
    },
    "origen_cambio": {
      "type": "string",
      "enum": [
        "primer_registro",
        "subida_pvp",
        "cambio_descuento",
        "ambos",
        "cambio_valoracion_no_deducible"
      ],
      "description": "Causa deducible del cambio de precio"
    },
    "documento_origen_id": {
      "type": "string",
      "description": "ID del MaterialDocumentoOrigen que origin\u00f3 este precio"
    },
    "documento_tipo": {
      "type": "string",
      "enum": [
        "factura",
        "albaran",
        "ticket",
        "proforma"
      ],
      "default": "factura"
    },
    "documento_numero": {
      "type": "string",
      "description": "N\u00ba impreso en el documento (factura/albar\u00e1n/proforma)"
    },
    "documento_url": {
      "type": "string",
      "description": "URL del archivo procesado (CDN/Drive) para abrir el original"
    },
    "proveedor_nombre": {
      "type": "string"
    },
    "proveedor_nif": {
      "type": "string"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "linea_ocr_raw": {
      "type": "string",
      "description": "Texto crudo de la l\u00ednea original (auditor\u00eda)"
    },
    "confianza": {
      "type": "string",
      "enum": [
        "alta",
        "media",
        "baja"
      ],
      "default": "media"
    },
    "cliente_contratante_id": {
      "type": "string",
      "description": "ID del cliente CONTRATANTE al que aplica esta tarifa. Permite tarifas diferenciadas por contratante (caso ObraCheck: mismo proveedor, distinto precio seg\u00fan qui\u00e9n contrata \u2014 Consistrol vs Clauger). Vac\u00edo = tarifa general aplicable a cualquier contratante."
    },
    "cliente_contratante_name": {
      "type": "string",
      "description": "Nombre del cliente contratante (denormalizado para listados/filtros)."
    },
    "proyecto_ingenieria_id": {
      "type": "string",
      "description": "Alias de obra_id cuando el precio pertenece a un proyecto de ingenier\u00eda. Se rellena con el mismo obra_id (no se duplica). Facilita filtros del m\u00f3dulo Ingenier\u00eda."
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "fecha_documento",
    "precio_neto"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "contabilidad"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}