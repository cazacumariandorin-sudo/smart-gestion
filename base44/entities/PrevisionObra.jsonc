{
  "name": "PrevisionObra",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID de la obra"
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio prevista"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin prevista"
    },
    "operarios_asignados": {
      "type": "array",
      "description": "Operarios asignados a esta previsión",
      "items": {
        "type": "object",
        "properties": {
          "operario_id": {
            "type": "string"
          },
          "operario_name": {
            "type": "string"
          },
          "rol": {
            "type": "string"
          },
          "horas_previstas": {
            "type": "number"
          }
        }
      }
    },
    "horas_totales_previstas": {
      "type": "number",
      "description": "Total horas previstas"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    },
    "status": {
      "type": "string",
      "enum": [
        "planificada",
        "en_curso",
        "completada",
        "cancelada"
      ],
      "default": "planificada",
      "description": "Estado de la previsión"
    },
    "horas_reales_acumuladas": {
      "type": "number",
      "default": 0,
      "description": "Suma horas_trabajadas de Fichajes vinculados"
    },
    "desviacion_horas": {
      "type": "number",
      "default": 0,
      "description": "horas_totales_previstas - horas_reales_acumuladas"
    },
    "porcentaje_avance_horas": {
      "type": "number",
      "default": 0,
      "description": "% de horas ejecutadas sobre previstas"
    },
    "ultimo_fichaje_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del último Fichaje en esta obra"
    },
    "operarios_activos_hoy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs operarios que ficharon hoy"
    },
    "status_semaforo": {
      "type": "string",
      "enum": [
        "verde",
        "amarillo",
        "rojo",
        "sin_datos"
      ],
      "default": "sin_datos",
      "description": "Estado visual de avance"
    }
  },
  "required": [
    "obra_name",
    "fecha_inicio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "cliente_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        },
        {
          "data.client_id": "{{user.client_id}}"
        },
        {
          "$and": [
            {
              "data.status": {
                "$in": [
                  "planificada",
                  "en_curso"
                ]
              }
            },
            {
              "user_condition": {
                "role": "cliente_obra"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "$and": [
            {
              "data.client_id": "{{user.client_id}}"
            },
            {
              "user_condition": {
                "role": "cliente_obra"
              }
            },
            {
              "data.status": {
                "$in": [
                  "planificada"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    }
  }
}
