{
  "name": "PrevisionObra",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "fecha_fin": {
      "format": "date",
      "type": "string"
    },
    "fecha_inicio": {
      "format": "date",
      "type": "string"
    },
    "horas_totales_previstas": {
      "type": "number"
    },
    "notas": {
      "type": "string"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "operarios_asignados": {
      "items": {
        "properties": {
          "horas_previstas": {
            "type": "number"
          },
          "operario_id": {
            "type": "string"
          },
          "operario_name": {
            "type": "string"
          },
          "rol": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "default": "planificada",
      "enum": [
        "planificada",
        "en_curso",
        "completada",
        "cancelada"
      ],
      "type": "string"
    }
  },
  "required": [
    "obra_name",
    "fecha_inicio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}