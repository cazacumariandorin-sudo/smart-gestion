{
  "name": "SolarLegalizacion",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "fecha_resolucion": {
      "format": "date",
      "type": "string"
    },
    "fecha_solicitud": {
      "format": "date",
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "organismo": {
      "type": "string"
    },
    "referencia": {
      "type": "string"
    },
    "status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "en_tramite",
        "aprobado",
        "rechazado"
      ],
      "type": "string"
    },
    "tipo_tramite": {
      "enum": [
        "proyecto_tecnico",
        "licencia_obra",
        "boletin_instalacion",
        "tramite_red",
        "certificado_final",
        "subvencion",
        "otros"
      ],
      "type": "string"
    }
  },
  "required": [
    "obra_id",
    "tipo_tramite"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}