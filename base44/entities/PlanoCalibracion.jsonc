{
  "name": "PlanoCalibracion",
  "type": "object",
  "properties": {
    "drawing_id": {
      "type": "string",
      "description": "ID del Drawing (plano) al que se aplica esta calibraci\u00f3n. Un Drawing puede tener varias recalibraciones (versiones); la vigente es la de fecha_calibracion m\u00e1s reciente."
    },
    "obra_id": {
      "type": "string",
      "description": "ID de la obra (proyecto de ingenier\u00eda) a la que pertenece el plano."
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra (denormalizado)."
    },
    "nombre_planta": {
      "type": "string",
      "description": "Nombre de la planta/estancia del plano ('Planta Baja', 'Sala de M\u00e1quinas')."
    },
    "punto_calibracion_1": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "description": "Coordenadas en P\u00cdXELES del primer punto de referencia marcado sobre la imagen del plano."
    },
    "punto_calibracion_2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "description": "Coordenadas en P\u00cdXELES del segundo punto de referencia."
    },
    "distancia_real_calibracion_m": {
      "type": "number",
      "description": "Distancia real conocida en METROS entre los dos puntos de calibraci\u00f3n. Junto con la distancia en px entre los dos puntos, deriva escala_px_por_metro. NO se usan coordenadas absolutas en metros; se usa una distancia conocida."
    },
    "escala_px_por_metro": {
      "type": "number",
      "description": "Escala calculada: distancia_px_entre_puntos / distancia_real_calibracion_m. Derivada; el backend o la UI la recalculan al guardar."
    },
    "metodo_calibracion": {
      "type": "string",
      "enum": [
        "cota_conocida",
        "circuito_potencia_ya_medido"
      ],
      "description": "M\u00e9todo de calibraci\u00f3n: cota_conocida (cota impresa o medida directa) o circuito_potencia_ya_medido (se reutiliza un circuito de potencia/tuber\u00eda ya medido como referencia cuando no hay cota expl\u00edcita). El documento prioriza reutilizar circuitos ya medidos."
    },
    "fecha_calibracion": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO en que se realiz\u00f3/recalibr\u00f3 esta calibraci\u00f3n."
    },
    "calibrado_por": {
      "type": "string",
      "description": "Email del ingeniero que calibr\u00f3 el plano."
    },
    "confianza_calibracion": {
      "type": "string",
      "enum": [
        "alta",
        "media",
        "baja"
      ],
      "default": "media",
      "description": "Confianza de la calibraci\u00f3n. Alta = cota conocida precisa o circuito medido lejano; baja = puntos cercanos o medida imprecisa."
    },
    "notas": {
      "type": "string",
      "description": "Observaciones del ingeniero sobre la calibraci\u00f3n."
    }
  },
  "required": [
    "drawing_id",
    "obra_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}