{
  "name": "Empresa",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre o razón social de la empresa"
    },
    "cif": {
      "type": "string",
      "description": "CIF / NIF de la empresa"
    },
    "domicilio": {
      "type": "string",
      "description": "Dirección fiscal"
    },
    "localidad": {
      "type": "string",
      "description": "Localidad"
    },
    "provincia": {
      "type": "string",
      "description": "Provincia"
    },
    "codigo_postal": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "web": {
      "type": "string"
    },
    "activa": {
      "type": "boolean",
      "default": true,
      "description": "Si la empresa está activa"
    },
    "es_principal": {
      "type": "boolean",
      "default": false,
      "description": "True si esta es la empresa principal del workspace (SIMANTEC SL)"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "nombre",
    "cif"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
