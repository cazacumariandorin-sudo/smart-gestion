{
  "name": "Empresa",
  "properties": {
    "activa": {
      "default": true,
      "description": "Si la empresa est\u00e1 activa",
      "type": "boolean"
    },
    "actividad_principal": {
      "description": "Actividad / sector principal (CNAE descriptivo). Ej: Instalaciones el\u00e9ctricas y fotovoltaicas.",
      "type": "string"
    },
    "cif": {
      "description": "CIF / NIF de la empresa",
      "type": "string"
    },
    "codigo_postal": {
      "type": "string"
    },
    "domicilio": {
      "description": "Direcci\u00f3n fiscal",
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "es_principal": {
      "default": false,
      "description": "True si esta es la empresa principal del workspace (SIMANTEC SL)",
      "type": "boolean"
    },
    "fecha_constitucion": {
      "description": "Fecha de constituci\u00f3n de la empresa",
      "format": "date",
      "type": "string"
    },
    "iban": {
      "description": "IBAN de la cuenta principal (para emitir/recibir facturas y remesas SEPA)",
      "type": "string"
    },
    "localidad": {
      "description": "Localidad",
      "type": "string"
    },
    "logo_url": {
      "description": "URL del logotipo corporativo de la empresa (subido a CDN Base44)",
      "type": "string"
    },
    "logo_2_url": {
      "description": "URL del Logo 2 de la empresa (subido a CDN Base44). Es el logotipo alternativo que se puede elegir en los presupuestos y sale en su PDF.",
      "type": "string"
    },
    "nombre": {
      "description": "Nombre o raz\u00f3n social de la empresa",
      "type": "string"
    },
    "notas": {
      "description": "Observaciones",
      "type": "string"
    },
    "provincia": {
      "description": "Provincia",
      "type": "string"
    },
    "razon_social": {
      "description": "Raz\u00f3n social completa tal y como sale en las facturas (opcional). Si est\u00e1 vac\u00eda, los PDF usan el nombre",
      "type": "string"
    },
    "registro_mercantil": {
      "description": "Dato de inscripci\u00f3n en el Registro Mercantil (Tomo, Folio, Secci\u00f3n, Hoja, Inscripci\u00f3n)",
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "web": {
      "type": "string"
    }
  },
  "required": [
    "nombre",
    "cif"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "contabilidad"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    }
  },
  "type": "object"
}