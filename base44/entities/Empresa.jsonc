{
  "name": "Empresa",
  "type": "object",
  "description": "Empresa del grupo. Cada registro es el espacio de una empresa: sus datos fiscales, su plan y sus costes. El campo empresa_id (igual al propio id) es la frontera de aislamiento: una empresa solo puede leer y editar su propia ficha; el propietario de la app ve todas.",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "\u00c1mbito de la empresa: se rellena con su propio id al crearla. Las reglas de acceso comparan este valor con la empresa del usuario, de modo que nadie ve la ficha de otra empresa."
    },
    "activa": {
      "default": true,
      "description": "Si la empresa est\u00e1 activa",
      "type": "boolean"
    },
    "actividad_principal": {
      "description": "Actividad / sector principal (CNAE descriptivo). Ej: Instalaciones el\u00e9ctricas y fotovoltaicas.",
      "type": "string"
    },
    "cif": {
      "description": "CIF / NIF de la empresa",
      "type": "string"
    },
    "codigo_postal": {
      "type": "string"
    },
    "domicilio": {
      "description": "Direcci\u00f3n fiscal",
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "es_principal": {
      "default": false,
      "description": "True si esta es la empresa principal del workspace (SIMANTEC SL)",
      "type": "boolean"
    },
    "fecha_constitucion": {
      "description": "Fecha de constituci\u00f3n de la empresa",
      "format": "date",
      "type": "string"
    },
    "iban": {
      "description": "IBAN de la cuenta principal (para emitir/recibir facturas y remesas SEPA)",
      "type": "string"
    },
    "localidad": {
      "description": "Localidad",
      "type": "string"
    },
    "logo_url": {
      "description": "URL del logotipo corporativo de la empresa (subido a CDN Base44)",
      "type": "string"
    },
    "logo_2_url": {
      "description": "URL del Logo 2 de la empresa (subido a CDN Base44). Es el logotipo alternativo que se puede elegir en los presupuestos y sale en su PDF.",
      "type": "string"
    },
    "nombre": {
      "description": "Nombre o raz\u00f3n social de la empresa",
      "type": "string"
    },
    "notas": {
      "description": "Observaciones",
      "type": "string"
    },
    "provincia": {
      "description": "Provincia",
      "type": "string"
    },
    "razon_social": {
      "description": "Raz\u00f3n social completa tal y como sale en las facturas (opcional). Si est\u00e1 vac\u00eda, los PDF usan el nombre",
      "type": "string"
    },
    "registro_mercantil": {
      "description": "Dato de inscripci\u00f3n en el Registro Mercantil (Tomo, Folio, Secci\u00f3n, Hoja, Inscripci\u00f3n)",
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "web": {
      "type": "string"
    }
  },
  "required": [
    "nombre",
    "cif"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "es_propietario_global": true
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "es_propietario_global": true
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            },
            {
              "user_condition": {
                "role": "administracion"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "es_propietario_global": true
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}