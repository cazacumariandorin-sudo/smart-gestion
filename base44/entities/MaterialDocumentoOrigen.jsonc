{
  "name": "MaterialDocumentoOrigen",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "factura",
        "albaran",
        "ticket",
        "proforma",
        "pedido",
        "presupuesto",
        "listado_puntos",
        "lista_material",
        "esquema_conexion",
        "pid_proceso",
        "esquema_hidraulico",
        "plano_planta",
        "ficha_tecnica_equipo"
      ],
      "default": "factura",
      "description": "Tipo de documento. Originales comerciales: factura/albaran/ticket/proforma. Módulo Ingeniería: pedido, presupuesto, listado_puntos, lista_material, esquema_conexion, pid_proceso, esquema_hidraulico, plano_planta, ficha_tecnica_equipo."
    },
    "numero_documento": { "type": "string" },
    "revision": {
      "type": "string",
      "description": "Código de revisión impreso en el documento."
    },
    "fecha_documento": { "type": "string", "format": "date" },
    "proveedor_nombre": { "type": "string" },
    "proveedor_nif": { "type": "string" },
    "archivo_url_mejorado": {
      "type": "string",
      "description": "URL del archivo pre-procesado tipo CamScanner (el usado para OCR)"
    },
    "archivo_url_original": {
      "type": "string",
      "description": "URL del archivo original sin procesar (opcional)"
    },
    "obra_id": { "type": "string" },
    "obra_name": { "type": "string" },
    "operario_id": { "type": "string" },
    "proyecto_ingenieria_id": {
      "type": "string",
      "description": "Alias de obra_id cuando el documento pertenece a un proyecto de ingeniería."
    },
    "ingeniero_subido_por": {
      "type": "string",
      "description": "Email del ingeniero que subió el documento."
    },
    "version_documento": {
      "type": "string",
      "description": "Versión del plano/esquema."
    },
    "fecha_revision_documento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de revisión impresa en planos/esquemas."
    },
    "estado": {
      "type": "string",
      "enum": ["pendiente_revision", "procesado", "error", "superseded", "descartado"],
      "default": "procesado",
      "description": "Estado del documento."
    },
    "datos_extraidos": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON crudo de la extracción IA antes de partirlo en ItemLista/PartidaPedido/etc."
    },
    "numero_orden_compra_cliente": {
      "type": "string",
      "description": "Solo tipo=presupuesto: número de orden de compra del cliente."
    },
    "presupuestos_previos_referenciados": {
      "type": "string",
      "description": "Solo tipo=presupuesto: presupuestos previos referenciados."
    },
    "valido_hasta": {
      "type": "string",
      "format": "date",
      "description": "Solo tipo=presupuesto: fecha de validez del presupuesto."
    },
    "lineas_count": {
      "type": "number",
      "default": 0
    },
    "conciliado_contabilidad": {
      "type": "boolean",
      "default": false
    },
    "fecha_conciliacion": {
      "type": "string",
      "format": "date-time"
    },
    "conciliado_por": { "type": "string" },
    "nota_conciliacion": { "type": "string" },
    "estado_conciliacion": {
      "type": "string",
      "enum": ["no_conciliado", "conciliado", "conciliado_con_discrepancia"],
      "default": "no_conciliado"
    },
    "discrepancia_tarea_id": { "type": "string" },
    "resolucion_estado": {
      "type": "string",
      "enum": ["sin_discrepancia", "pendiente", "resuelta", "cerrada"],
      "default": "sin_discrepancia"
    },
    "resolucion_por": { "type": "string" },
    "fecha_resolucion": { "type": "string", "format": "date-time" },
    "descargado_contabilidad": { "type": "boolean", "default": false },
    "fecha_descarga": { "type": "string", "format": "date-time" },
    "descargado_por": { "type": "string" },
    "nota_gasto_id": {
      "type": "string",
      "description": "ID del RegistroGasto que originó este documento (enlace explícito para marcar notas de gasto ya migradas a materiales)."
    },
    "nota_origen_tipo": {
      "type": "string",
      "description": "Tipo de origen del documento: nota_gasto, OCR, etc."
    }
  },
  "required": ["tipo", "fecha_documento"],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "propietario" } },
        { "user_condition": { "role": "gerencia" } },
        { "user_condition": { "role": "administracion" } },
        { "user_condition": { "role": "director_comercial" } },
        { "user_condition": { "role": "jefe_obra" } },
        { "user_condition": { "role": "ingeniero" } }
      ]
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "propietario" } },
        { "user_condition": { "role": "gerencia" } },
        { "user_condition": { "role": "administracion" } },
        { "user_condition": { "role": "director_comercial" } },
        { "user_condition": { "role": "jefe_obra" } },
        { "user_condition": { "role": "contabilidad" } },
        { "user_condition": { "role": "ingeniero" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "propietario" } },
        { "user_condition": { "role": "gerencia" } },
        { "user_condition": { "role": "administracion" } },
        { "user_condition": { "role": "director_comercial" } },
        { "user_condition": { "role": "jefe_obra" } },
        { "user_condition": { "role": "ingeniero" } }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "propietario" } }
      ]
    }
  }
}
