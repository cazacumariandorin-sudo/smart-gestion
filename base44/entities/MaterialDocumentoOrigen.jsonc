{
  "name": "MaterialDocumentoOrigen",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "factura",
        "albaran",
        "ticket",
        "proforma",
        "pedido",
        "presupuesto",
        "esquema_conexion",
        "pid_proceso",
        "plano_planta",
        "ficha_tecnica_equipo",
        "listado_puntos"
      ],
      "default": "factura",
      "description": "Tipo de documento. Los 4 originales (factura/albaran/ticket/proforma) cubren el flujo de materiales/gastos. Los 7 nuevos cubren el m\u00f3dulo Ingenier\u00eda/ObraCheck: pedido, presupuesto, esquema_conexion (esquema el\u00e9ctrico/unifilar), pid_proceso (P&ID de instrumentaci\u00f3n), plano_planta, ficha_tecnica_equipo, listado_puntos."
    },
    "numero_documento": {
      "type": "string"
    },
    "fecha_documento": {
      "type": "string",
      "format": "date"
    },
    "proveedor_nombre": {
      "type": "string"
    },
    "proveedor_nif": {
      "type": "string"
    },
    "archivo_url_mejorado": {
      "type": "string",
      "description": "URL del archivo pre-procesado tipo CamScanner (el usado para OCR)"
    },
    "archivo_url_original": {
      "type": "string",
      "description": "URL del archivo original sin procesar (opcional)"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "proyecto_ingenieria_id": {
      "type": "string",
      "description": "obra_id cuando el documento pertenece a un proyecto de ingenier\u00eda. Se rellena con el mismo obra_id (no se duplica). Facilita filtros del m\u00f3dulo Ingenier\u00eda y aislamiento de documentos ingenieriles del flujo de materiales general."
    },
    "ingeniero_subido_por": {
      "type": "string",
      "description": "Email del ingeniero que subi\u00f3 el documento (para RLS y filtros). Distinto de operario_id (t\u00e9cnico de campo) en el contexto de Ingenier\u00eda."
    },
    "version_documento": {
      "type": "string",
      "description": "Versi\u00f3n del plano/esquema (P&ID v1, v2...). Vac\u00edo en documentos comerciales (facturas/pedidos)."
    },
    "fecha_revision_documento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de revisi\u00f3n impresa en planos/esquemas. Vac\u00eda en documentos comerciales."
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente_revision",
        "procesado",
        "descartado"
      ],
      "default": "procesado"
    },
    "lineas_count": {
      "type": "number",
      "default": 0
    },
    "conciliado_contabilidad": {
      "type": "boolean",
      "default": false,
      "description": "Marca de conciliado por la gestor\u00eda (rol contabilidad). Solo la funci\u00f3n marcarConciliacionContable escribe este campo."
    },
    "fecha_conciliacion": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO en que la gestor\u00eda marc\u00f3 la conciliaci\u00f3n."
    },
    "conciliado_por": {
      "type": "string",
      "description": "Email del usuario contabilidad que marc\u00f3 la conciliaci\u00f3n."
    },
    "nota_conciliacion": {
      "type": "string",
      "description": "Anotaci\u00f3n libre de la gestor\u00eda (discrepancias, referencias contables)."
    },
    "estado_conciliacion": {
      "type": "string",
      "enum": [
        "no_conciliado",
        "conciliado",
        "conciliado_con_discrepancia"
      ],
      "default": "no_conciliado",
      "description": "Estado derivado de la conciliaci\u00f3n."
    },
    "discrepancia_tarea_id": {
      "type": "string",
      "description": "ID de la AsistenteTarea de alta prioridad creada al marcar conciliado_con_discrepancia."
    },
    "resolucion_estado": {
      "type": "string",
      "enum": [
        "sin_discrepancia",
        "pendiente",
        "resuelta",
        "cerrada"
      ],
      "default": "sin_discrepancia",
      "description": "Ciclo de vida de la discrepancia."
    },
    "resolucion_por": {
      "type": "string"
    },
    "fecha_resolucion": {
      "type": "string",
      "format": "date-time"
    },
    "descargado_contabilidad": {
      "type": "boolean",
      "default": false,
      "description": "True si este documento ya se incluy\u00f3 en una descarga en bloque (ZIP/Excel) entregada a contabilidad."
    },
    "fecha_descarga": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO en que se incluy\u00f3 en una descarga en bloque."
    },
    "descargado_por": {
      "type": "string",
      "description": "Email de quien gener\u00f3 la descarga en bloque que incluy\u00f3 este documento."
    }
  },
  "required": [
    "tipo",
    "fecha_documento"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "contabilidad"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}