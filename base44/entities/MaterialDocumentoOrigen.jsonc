{
  "name": "MaterialDocumentoOrigen",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "factura",
        "albaran",
        "ticket",
        "proforma",
        "pedido",
        "presupuesto",
        "listado_puntos",
        "lista_material",
        "esquema_conexion",
        "pid_proceso",
        "esquema_hidraulico",
        "plano_planta",
        "ficha_tecnica_equipo"
      ],
      "default": "factura",
      "description": "Tipo de documento. Originales comerciales: factura/albaran/ticket/proforma. M\u00f3dulo Ingenier\u00eda: pedido, presupuesto, listado_puntos, lista_material (distinto de listado_puntos: es la 'Lista de Material' de proceso tipo R717), esquema_conexion (el\u00e9ctrico/unifilar), pid_proceso (instrumentaci\u00f3n), esquema_hidraulico (frigor\u00edfico/fluidos), plano_planta, ficha_tecnica_equipo."
    },
    "numero_documento": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "description": "C\u00f3digo de revisi\u00f3n impreso en el documento (PE176J-26, P-2026-0034, R3B, R2.0, R1, R717, 21217AA00-DM01...). Clave de agrupaci\u00f3n para el comparador de revisiones de ItemLista."
    },
    "fecha_documento": {
      "type": "string",
      "format": "date"
    },
    "proveedor_nombre": {
      "type": "string"
    },
    "proveedor_nif": {
      "type": "string"
    },
    "archivo_url_mejorado": {
      "type": "string",
      "description": "URL del archivo pre-procesado tipo CamScanner (el usado para OCR)"
    },
    "archivo_url_original": {
      "type": "string",
      "description": "URL del archivo original sin procesar (opcional)"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "proyecto_ingenieria_id": {
      "type": "string",
      "description": "obra_id cuando el documento pertenece a un proyecto de ingenier\u00eda. Se rellena con el mismo obra_id (no se duplica). Facilita filtros del m\u00f3dulo Ingenier\u00eda y aislamiento de documentos ingenieriles del flujo de materiales general."
    },
    "ingeniero_subido_por": {
      "type": "string",
      "description": "Email del ingeniero que subi\u00f3 el documento (para RLS y filtros). Distinto de operario_id (t\u00e9cnico de campo) en el contexto de Ingenier\u00eda."
    },
    "version_documento": {
      "type": "string",
      "description": "Versi\u00f3n del plano/esquema (P&ID v1, v2...). Alias legible de revision. Vac\u00edo en documentos comerciales (facturas/pedidos)."
    },
    "fecha_revision_documento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de revisi\u00f3n impresa en planos/esquemas. Vac\u00eda en documentos comerciales."
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente_revision",
        "procesado",
        "error",
        "superseded",
        "descartado"
      ],
      "default": "procesado",
      "description": "estado_procesado del original: pendiente_revision (pendiente de extracci\u00f3n IA) | procesado (extracci\u00f3n OK) | error (extracci\u00f3n IA fallida) | superseded (presupuesto reemplazado por uno m\u00e1s reciente que lo referencia \u2014 regla 8) | descartado."
    },
    "datos_extraidos": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON crudo de la extracci\u00f3n IA antes de partirlo en ItemLista/PartidaPedido/etc. Permite re-procesamiento y auditor\u00eda sin re-subir el archivo."
    },
    "numero_orden_compra_cliente": {
      "type": "string",
      "description": "Solo tipo=presupuesto: n\u00ba de orden de compra del cliente impreso (Y2061315)."
    },
    "presupuestos_previos_referenciados": {
      "type": "string",
      "description": "Solo tipo=presupuesto: presupuestos previos referenciados (texto, ej. 'PRESUS 30+31'). La regla 8 marca esos documentos previos como superseded."
    },
    "valido_hasta": {
      "type": "string",
      "format": "date",
      "description": "Solo tipo=presupuesto: fecha de validez del presupuesto (15/07/2026)."
    },
    "lineas_count": {
      "type": "number",
      "default": 0
    },
    "conciliado_contabilidad": {
      "type": "boolean",
      "default": false
    },
    "fecha_conciliacion": {
      "type": "string",
      "format": "date-time"
    },
    "conciliado_por": {
      "type": "string"
    },
    "nota_conciliacion": {
      "type": "string"
    },
    "estado_conciliacion": {
      "type": "string",
      "enum": [
        "no_conciliado",
        "conciliado",
        "conciliado_con_discrepancia"
      ],
      "default": "no_conciliado"
    },
    "discrepancia_tarea_id": {
      "type": "string"
    },
    "resolucion_estado": {
      "type": "string",
      "enum": [
        "sin_discrepancia",
        "pendiente",
        "resuelta",
        "cerrada"
      ],
      "default": "sin_discrepancia"
    },
    "resolucion_por": {
      "type": "string"
    },
    "fecha_resolucion": {
      "type": "string",
      "format": "date-time"
    },
    "descargado_contabilidad": {
      "type": "boolean",
      "default": false
    },
    "fecha_descarga": {
      "type": "string",
      "format": "date-time"
    },
    "descargado_por": {
      "type": "string"
    }
  },
  "required": [
    "tipo",
    "fecha_documento"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "contabilidad"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}