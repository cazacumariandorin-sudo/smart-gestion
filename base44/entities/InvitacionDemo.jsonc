{
  "name": "InvitacionDemo",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "Código único UUID del link de invitación"
    },
    "generada_por_email": {
      "type": "string",
      "description": "Email del usuario que generó la invitación"
    },
    "generada_por_nombre": {
      "type": "string",
      "description": "Nombre del usuario que generó la invitación"
    },
    "email_destino": {
      "type": "string",
      "description": "Email destino (opcional)"
    },
    "duracion_dias": {
      "type": "number",
      "description": "Duración en días: 7, 15, 30 o 60"
    },
    "fecha_generacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha/hora de generación"
    },
    "fecha_expiracion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha/hora de expiración del link"
    },
    "usada": {
      "type": "boolean",
      "default": false,
      "description": "Si el link ya fue usado"
    },
    "fecha_uso": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se usó"
    },
    "demo_user_id": {
      "type": "string",
      "description": "ID del usuario demo creado"
    },
    "demo_user_email": {
      "type": "string",
      "description": "Email del usuario demo creado"
    },
    "activa": {
      "type": "boolean",
      "default": true,
      "description": "Si la invitación está activa (no revocada)"
    }
  },
  "required": [
    "codigo",
    "generada_por_email",
    "duracion_dias"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
