{
  "name": "Discrepancia",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID de la obra (proyecto de ingenier\u00eda)."
    },
    "tipo": {
      "type": "string",
      "enum": [
        "punto_a\u00f1adido",
        "punto_eliminado",
        "cantidad_no_coincide",
        "cantidad_puntos_pedido_vs_listado",
        "precio_unitario_inconsistente_entre_proyectos",
        "precio_no_coincide",
        "material_no_facturado",
        "material_no_especificado",
        "riesgo_precio_distancia",
        "distancia_plano_vs_pedido",
        "dise\u00f1o_pendiente",
        "especificacion_tecnica_inconsistente"
      ],
      "description": "Los 12 tipos del documento ObraCheck: diff revisiones (punto_a\u00f1adido/punto_eliminado), cantidad (cantidad_no_coincide factura vs pedido / cantidad_puntos_pedido_vs_listado bulto vs recuento), precio (precio_unitario_inconsistente_entre_proyectos tarifa / precio_no_coincide factura vs pedido), material (material_no_facturado en pedido no en factura / material_no_especificado en factura no en pedido), distancia (riesgo_precio_distancia sobrecoste / distancia_plano_vs_pedido), dise\u00f1o_pendiente (anotaciones manuscritas), especificacion_tecnica_inconsistente (motor\u2194variador)."
    },
    "severidad": {
      "type": "string",
      "enum": [
        "alta",
        "media",
        "baja"
      ],
      "default": "media"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n legible de la discrepancia."
    },
    "tag_afectado": {
      "type": "string",
      "description": "TAG(s) afectado(s) (AHU01_R3Dmp1Cmd, AHU01_R3Dmp2Cmd, L1). Multi-tag separado por coma."
    },
    "documentos_implicados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de MaterialDocumentoOrigen implicados en la discrepancia (pedido, listado, esquema, factura...)."
    },
    "valor_esperado": {
      "type": "string",
      "description": "Valor esperado (seg\u00fan tarifa/pedido/presupuesto) en texto."
    },
    "valor_real": {
      "type": "string",
      "description": "Valor encontrado (en factura/medici\u00f3n/certificaci\u00f3n) en texto."
    },
    "importe_no_facturado": {
      "type": "number",
      "description": "Importe no facturado estimado (157.00\u20ac en CIBA: 2 puntos \u00d7 78.50\u20ac). \u00datil para priorizar severidad."
    },
    "estado": {
      "type": "string",
      "enum": [
        "abierta",
        "revisada",
        "resuelta",
        "descartada"
      ],
      "default": "abierta",
      "description": "Ciclo de vida: abierta \u2192 revisada (en revisi\u00f3n humana) \u2192 resuelta (o descartada=falsa alarma)."
    },
    "asignada_a": {
      "type": "string",
      "description": "Email del ingeniero/gerencia asignado a resolver."
    },
    "resuelta_por": {
      "type": "string"
    },
    "fecha_resolucion": {
      "type": "string",
      "format": "date-time"
    },
    "resolucion_accion": {
      "type": "string",
      "description": "Acci\u00f3n tomada para resolver (corregir factura, ajustar pedido, aceptar diferencia, etc.)."
    },
    "notas_resolucion": {
      "type": "string"
    },
    "fecha_deteccion": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO en que la funci\u00f3n conciliarProyectoIngenieria detect\u00f3 la discrepancia."
    }
  },
  "required": [
    "obra_id",
    "tipo",
    "descripcion"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}