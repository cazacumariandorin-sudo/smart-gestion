{
  "name": "GdriveSyncState",
  "type": "object",
  "properties": {
    "recurso_tipo": {
      "type": "string",
      "description": "Tipo de recurso: folder, file, webhook"
    },
    "recurso_id": {
      "type": "string",
      "description": "ID del recurso en Google Drive"
    },
    "recurso_nombre": {
      "type": "string",
      "description": "Nombre del recurso"
    },
    "ruta_completa": {
      "type": "string",
      "description": "Ruta completa en Google Drive (ej: /Obras/Materiales)"
    },
    "parent_id": {
      "type": "string",
      "description": "ID del padre en Google Drive"
    },
    "page_token": {
      "type": "string",
      "description": "Último page token para webhooks de cambios"
    },
    "ultima_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de última sincronización"
    },
    "estado": {
      "type": "string",
      "enum": [
        "activo",
        "error",
        "pendiente"
      ],
      "default": "activo",
      "description": "Estado de la sincronización"
    },
    "errores": {
      "type": "string",
      "description": "Descripción de errores si los hay"
    }
  },
  "required": [
    "recurso_tipo",
    "recurso_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
