{
  "name": "ViajeVehiculo",
  "type": "object",
  "properties": {
    "coste_combustible_estimado": {
      "description": "Coste estimado en combustible (€)",
      "type": "number"
    },
    "distancia_km": {
      "description": "Distancia recorrida en km",
      "type": "number"
    },
    "duracion_minutos": {
      "description": "Duración total del viaje en minutos",
      "type": "number"
    },
    "fecha": {
      "description": "Fecha del viaje",
      "format": "date",
      "type": "string"
    },
    "fin_direccion": {
      "description": "Dirección de destino",
      "type": "string"
    },
    "fin_lat": {
      "description": "Latitud de destino",
      "type": "number"
    },
    "fin_lng": {
      "description": "Longitud de destino",
      "type": "number"
    },
    "hora_fin": {
      "description": "Hora de llegada (HH:MM)",
      "type": "string"
    },
    "hora_inicio": {
      "description": "Hora de salida (HH:MM)",
      "type": "string"
    },
    "inicio_direccion": {
      "description": "Dirección de origen",
      "type": "string"
    },
    "inicio_lat": {
      "description": "Latitud de origen",
      "type": "number"
    },
    "inicio_lng": {
      "description": "Longitud de origen",
      "type": "number"
    },
    "km_fin": {
      "description": "Km del vehículo al finalizar",
      "type": "number"
    },
    "km_inicio": {
      "description": "Km del vehículo al iniciar",
      "type": "number"
    },
    "notas": {
      "description": "Observaciones del conductor",
      "type": "string"
    },
    "operario_id": {
      "description": "ID del conductor",
      "type": "string"
    },
    "operario_name": {
      "description": "Nombre del conductor",
      "type": "string"
    },
    "proyecto_id": {
      "description": "ID del proyecto al que se vincula este viaje",
      "type": "string"
    },
    "proyecto_nombre": {
      "description": "Nombre del proyecto",
      "type": "string"
    },
    "tipo_viaje": {
      "default": "proyecto",
      "description": "Tipo de viaje",
      "enum": [
        "proyecto",
        "compras",
        "oficina",
        "traslado",
        "otro"
      ],
      "type": "string"
    },
    "validado": {
      "default": false,
      "description": "Si el admin ha validado el viaje",
      "type": "boolean"
    },
    "validado_por": {
      "description": "Email del usuario que validó",
      "type": "string"
    },
    "vehiculo_id": {
      "description": "ID del vehículo",
      "type": "string"
    },
    "vehiculo_matricula": {
      "description": "Matrícula del vehículo",
      "type": "string"
    },
    "velocidad_maxima": {
      "description": "Velocidad máxima registrada en el viaje (km/h)",
      "type": "number"
    },
    "velocidad_media": {
      "description": "Velocidad media del viaje (km/h)",
      "type": "number"
    }
  },
  "required": [
    "vehiculo_id",
    "vehiculo_matricula",
    "fecha",
    "hora_inicio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "control_horario"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    }
  }
}
