{
  "name": "RegistroGasto",
  "type": "object",
  "properties": {
    "archivos": {
      "items": {
        "properties": {
          "fecha_subida": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "categoria": {
      "enum": [
        "material",
        "combustible",
        "peaje",
        "parking",
        "comida",
        "otros"
      ],
      "type": "string"
    },
    "concepto": {
      "type": "string"
    },
    "codigo_validacion_fiscal": {
      "type": "string",
      "description": "C\u00f3digo QR o de barras extra\u00eddo del documento (identificador \u00fanico de transacci\u00f3n)"
    },
    "duplicado_confirmado": {
      "default": false,
      "type": "boolean"
    },
    "es_gasto_tardio": {
      "default": false,
      "type": "boolean"
    },
    "es_posible_duplicado": {
      "default": false,
      "type": "boolean"
    },
    "estado": {
      "default": "borrador",
      "enum": [
        "borrador",
        "pendiente",
        "aprobado_gerencia",
        "en_administracion",
        "pagada",
        "rechazada"
      ],
      "type": "string"
    },
    "fecha_creacion_real": {
      "format": "date",
      "type": "string"
    },
    "fecha_documento": {
      "format": "date",
      "type": "string"
    },
    "fecha_validacion": {
      "format": "date",
      "type": "string"
    },
    "importe": {
      "type": "number"
    },
    "justificacion_tardia": {
      "type": "string",
      "description": "Motivo por el que el gasto se registra con m\u00e1s de 30 d\u00edas de retraso"
    },
    "nif_comercio": {
      "type": "string"
    },
    "nombre_comercio": {
      "type": "string"
    },
    "notas_admin": {
      "type": "string"
    },
    "numero_nota": {
      "type": "string"
    },
    "numero_secuencia": {
      "type": "integer"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "obra_tipo": {
      "enum": [
        "obra",
        "solar",
        "manual"
      ],
      "type": "string"
    },
    "ocr_raw": {
      "type": "string"
    },
    "ocr_status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "procesado",
        "error"
      ],
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "validado_por": {
      "type": "string"
    },
    "aprobado_por": {
      "type": "string",
      "description": "Email de quien aprob\u00f3 el gasto (gerencia o director_comercial)"
    },
    "fecha_aprobacion": {
      "type": "string",
      "description": "Fecha ISO de la aprobaci\u00f3n"
    },
    "pagado_por": {
      "type": "string",
      "description": "Email del administrador que registr\u00f3 el pago"
    },
    "fecha_pago": {
      "type": "string",
      "description": "Fecha ISO en que se realiz\u00f3 el reembolso"
    },
    "importe_pagado_real": {
      "type": "number",
      "description": "Importe final pagado, puede diferir del original"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "transferencia",
        "efectivo",
        "tarjeta_empresa",
        "sepa"
      ]
    },
    "ia_no_disponible": {
      "type": "boolean",
      "default": false,
      "description": "True si la IA no pudo extraer datos del ticket al crear el registro \u2014 \u00fatil para auditor\u00eda"
    }
  },
  "required": [
    "operario_id",
    "categoria",
    "importe"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": {
                "$nin": [
                  "cerrada"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": "borrador"
            }
          ]
        }
      ]
    }
  }
}