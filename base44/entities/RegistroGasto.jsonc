{
  "name": "RegistroGasto",
  "type": "object",
  "properties": {
    "archivos": {
      "items": {
        "properties": {
          "fecha_subida": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "categoria": {
      "enum": [
        "material",
        "combustible",
        "peaje",
        "parking",
        "otros"
      ],
      "type": "string"
    },
    "concepto": {
      "type": "string"
    },
    "codigo_validacion_fiscal": {
      "type": "string",
      "description": "C\u00f3digo QR o de barras extra\u00eddo del documento (identificador \u00fanico de transacci\u00f3n)"
    },
    "duplicado_confirmado": {
      "default": false,
      "type": "boolean"
    },
    "es_gasto_tardio": {
      "default": false,
      "type": "boolean"
    },
    "es_posible_duplicado": {
      "default": false,
      "type": "boolean"
    },
    "estado": {
      "default": "borrador",
      "enum": [
        "borrador",
        "pendiente",
        "validada",
        "cerrada",
        "rechazada"
      ],
      "type": "string"
    },
    "fecha_creacion_real": {
      "format": "date",
      "type": "string"
    },
    "fecha_documento": {
      "format": "date",
      "type": "string"
    },
    "fecha_validacion": {
      "format": "date",
      "type": "string"
    },
    "importe": {
      "type": "number"
    },
    "nif_comercio": {
      "type": "string"
    },
    "nombre_comercio": {
      "type": "string"
    },
    "notas_admin": {
      "type": "string"
    },
    "numero_nota": {
      "type": "string"
    },
    "numero_secuencia": {
      "type": "integer"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "obra_tipo": {
      "enum": [
        "obra",
        "solar",
        "manual"
      ],
      "type": "string"
    },
    "ocr_raw": {
      "type": "string"
    },
    "ocr_status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "procesado",
        "error"
      ],
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "validado_por": {
      "type": "string"
    }
  },
  "required": [
    "operario_id",
    "categoria",
    "importe"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": {
                "$nin": [
                  "cerrada"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": "borrador"
            }
          ]
        }
      ]
    }
  }
}