{
  "name": "RegistroGasto",
  "type": "object",
  "properties": {
    "archivos": {
      "items": {
        "properties": {
          "fecha_subida": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "categoria": {
      "enum": [
        "material",
        "combustible",
        "peaje",
        "parking",
        "comida",
        "otros"
      ],
      "type": "string"
    },
    "concepto": {
      "type": "string"
    },
    "codigo_validacion_fiscal": {
      "type": "string",
      "description": "Código QR o de barras extraído del documento (identificador único de transacción)"
    },
    "numero_factura": {
      "type": "string",
      "description": "Número de factura / albarán / proforma impreso en el documento (extraído por OCR+IA)"
    },
    "duplicado_confirmado": {
      "default": false,
      "type": "boolean"
    },
    "es_gasto_tardio": {
      "default": false,
      "type": "boolean"
    },
    "es_posible_duplicado": {
      "default": false,
      "type": "boolean"
    },
    "estado": {
      "default": "borrador",
      "enum": [
        "borrador",
        "pendiente",
        "aprobado_gerencia",
        "en_administracion",
        "pagada",
        "rechazada"
      ],
      "type": "string"
    },
    "fecha_creacion_real": {
      "format": "date",
      "type": "string"
    },
    "fecha_documento": {
      "format": "date",
      "type": "string"
    },
    "fecha_validacion": {
      "format": "date",
      "type": "string"
    },
    "importe": {
      "type": "number"
    },
    "justificacion_tardia": {
      "type": "string",
      "description": "Motivo por el que el gasto se registra con más de 30 días de retraso"
    },
    "nif_comercio": {
      "type": "string"
    },
    "nombre_comercio": {
      "type": "string"
    },
    "notas_admin": {
      "type": "string"
    },
    "numero_nota": {
      "type": "string"
    },
    "numero_secuencia": {
      "type": "integer"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "obra_tipo": {
      "enum": [
        "obra",
        "solar",
        "manual"
      ],
      "type": "string"
    },
    "ocr_raw": {
      "type": "string"
    },
    "ocr_status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "procesado",
        "error"
      ],
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "operario_email": {
      "type": "string",
      "description": "Email del usuario vinculado al operario (denormalizado para RLS y filtros rápidos por usuario)"
    },
    "nota_mensual_id": {
      "type": "string",
      "description": "ID de la NotaMensualGasto a la que pertenece este registro (enlace al ciclo 26→25). Opcional para retrocompatibilidad con registros pre-migración."
    },
    "ciclo_mes": {
      "type": "string",
      "description": "Clave mes YYYY-MM del ciclo al que pertenece (denormalizada de NotaMensualGasto.ciclo_mes para filtros rápidos)"
    },
    "orden_en_ciclo": {
      "type": "integer",
      "description": "Número secuencial del registro dentro del ciclo del operario (1, 2, 3...)."
    },
    "validado_por": {
      "type": "string"
    },
    "aprobado_por": {
      "type": "string",
      "description": "Email de quien aprobó el gasto (gerencia o director_comercial)"
    },
    "fecha_aprobacion": {
      "type": "string",
      "description": "Fecha ISO de la aprobación"
    },
    "pagado_por": {
      "type": "string",
      "description": "Email del administrador que registró el pago"
    },
    "fecha_pago": {
      "type": "string",
      "description": "Fecha ISO en que se realizó el reembolso"
    },
    "importe_pagado_real": {
      "type": "number",
      "description": "Importe final pagado, puede diferir del original"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "transferencia",
        "efectivo",
        "tarjeta_empresa",
        "sepa"
      ]
    },
    "ia_no_disponible": {
      "type": "boolean",
      "default": false,
      "description": "True si la IA no pudo extraer datos del ticket al crear el registro — útil para auditoría"
    }
  },
  "required": [
    "operario_id",
    "categoria",
    "importe"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": {
                "$nin": [
                  "cerrada"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": "borrador"
            }
          ]
        }
      ]
    }
  }
}
