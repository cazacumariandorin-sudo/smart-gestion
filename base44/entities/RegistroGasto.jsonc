{
  "name": "RegistroGasto",
  "type": "object",
  "properties": {
    "archivos": {
      "items": {
        "properties": {
          "fecha_subida": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "categoria": {
      "enum": [
        "material",
        "combustible",
        "peaje",
        "parking",
        "comida",
        "otros"
      ],
      "type": "string"
    },
    "concepto": {
      "type": "string"
    },
    "codigo_validacion_fiscal": {
      "type": "string",
      "description": "C\u00f3digo QR o de barras extra\u00eddo del documento (identificador \u00fanico de transacci\u00f3n)"
    },
    "numero_factura": {
      "type": "string",
      "description": "N\u00famero de factura / albar\u00e1n / proforma impreso en el documento (extra\u00eddo por OCR+IA)"
    },
    "duplicado_confirmado": {
      "default": false,
      "type": "boolean"
    },
    "es_gasto_tardio": {
      "default": false,
      "type": "boolean"
    },
    "es_posible_duplicado": {
      "default": false,
      "type": "boolean"
    },
    "estado": {
      "default": "borrador",
      "enum": [
        "borrador",
        "pendiente",
        "aprobado_gerencia",
        "en_administracion",
        "pagada",
        "rechazada"
      ],
      "type": "string"
    },
    "fecha_creacion_real": {
      "format": "date",
      "type": "string"
    },
    "fecha_documento": {
      "format": "date",
      "type": "string"
    },
    "fecha_validacion": {
      "format": "date",
      "type": "string"
    },
    "importe": {
      "type": "number"
    },
    "justificacion_tardia": {
      "type": "string",
      "description": "Motivo por el que el gasto se registra con m\u00e1s de 30 d\u00edas de retraso"
    },
    "nif_comercio": {
      "type": "string"
    },
    "nombre_comercio": {
      "type": "string"
    },
    "notas_admin": {
      "type": "string"
    },
    "numero_nota": {
      "type": "string"
    },
    "numero_secuencia": {
      "type": "integer"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "obra_tipo": {
      "enum": [
        "obra",
        "solar",
        "manual"
      ],
      "type": "string"
    },
    "ocr_raw": {
      "type": "string"
    },
    "ocr_status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "procesado",
        "error"
      ],
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "operario_email": {
      "type": "string",
      "description": "Email del usuario vinculado al operario (denormalizado para RLS y filtros r\u00e1pidos por usuario)"
    },
    "nota_mensual_id": {
      "type": "string",
      "description": "ID de la NotaMensualGasto a la que pertenece este registro (enlace al ciclo 26\u219225). Opcional para retrocompatibilidad con registros pre-migraci\u00f3n."
    },
    "ciclo_mes": {
      "type": "string",
      "description": "Clave mes YYYY-MM del ciclo al que pertenece (denormalizada de NotaMensualGasto.ciclo_mes para filtros r\u00e1pidos)"
    },
    "orden_en_ciclo": {
      "type": "integer",
      "description": "N\u00famero secuencial del registro dentro del ciclo del operario (1, 2, 3...)."
    },
    "validado_por": {
      "type": "string"
    },
    "aprobado_por": {
      "type": "string",
      "description": "Email de quien aprob\u00f3 el gasto (gerencia o director_comercial)"
    },
    "fecha_aprobacion": {
      "type": "string",
      "description": "Fecha ISO de la aprobaci\u00f3n"
    },
    "pagado_por": {
      "type": "string",
      "description": "Email del administrador que registr\u00f3 el pago"
    },
    "fecha_pago": {
      "type": "string",
      "description": "Fecha ISO en que se realiz\u00f3 el reembolso"
    },
    "importe_pagado_real": {
      "type": "number",
      "description": "Importe final pagado, puede diferir del original"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "transferencia",
        "efectivo",
        "tarjeta_empresa",
        "sepa"
      ]
    },
    "ia_no_disponible": {
      "type": "boolean",
      "default": false,
      "description": "True si la IA no pudo extraer datos del ticket al crear el registro \u2014 \u00fatil para auditor\u00eda"
    },
    "precisa_precision": {
      "type": "boolean",
      "default": false,
      "description": "True si el OCR primario (InvokeLLM modelo por defecto) devolvi\u00f3 confianza baja o faltan campos clave (importe, fecha_documento, nombre_comercio). Pendiente de re-procesamiento con modelo superior."
    },
    "precision_motivo": {
      "type": "string",
      "description": "Motivo por el que se marc\u00f3 precisa_precision (ej: 'confianza 0.4', 'falta importe y fecha')."
    },
    "precision_revisado_por": {
      "type": "string",
      "description": "Email del admin/gerencia que ejecut\u00f3 el re-procesamiento de precisi\u00f3n."
    },
    "precision_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha ISO en que se ejecut\u00f3 el re-procesamiento de precisi\u00f3n."
    },
    "precision_modelo_usado": {
      "type": "string",
      "description": "Modelo usado en el re-procesamiento de precisi\u00f3n (ej: 'gemini_3_flash')."
    },
    "precision_diff": {
      "type": "string",
      "description": "Auditor\u00eda antes/despu\u00e9s del re-procesamiento (campos corregidos o a\u00f1adidos)."
    }
  },
  "required": [
    "operario_id",
    "categoria",
    "importe"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": {
                "$nin": [
                  "cerrada"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": "borrador"
            }
          ]
        }
      ]
    }
  }
}