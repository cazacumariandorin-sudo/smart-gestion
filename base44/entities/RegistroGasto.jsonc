{
  "name": "RegistroGasto",
  "type": "object",
  "properties": {
    "archivos": {
      "items": {
        "properties": {
                    "dhash": {
            "type": "string"
          },
          "fecha_subida": {
            "type": "string"
          },
          "mejorada": {
            "type": "boolean"
          },
          "nombre": {
            "type": "string"
          },
          "reemplazada": {
            "type": "boolean"
          },
          "storage": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
                   "url": {
            "type": "string"
          },
          "url_original": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "categoria": {
      "enum": [
        "material",
        "combustible",
        "peaje",
        "parking",
        "comida",
        "otros"
      ],
      "type": "string"
    },
    "concepto": {
      "type": "string"
    },
    "codigo_validacion_fiscal": {
      "type": "string",
      "description": "C\u00f3digo QR o de barras extra\u00eddo del documento (identificador \u00fanico de transacci\u00f3n)"
    },
    "numero_factura": {
      "type": "string",
      "description": "N\u00famero de factura / albar\u00e1n / proforma impreso en el documento (extra\u00eddo por OCR+IA)"
    },
    "localidad": {
      "type": "string",
      "description": "Localidad / poblaci\u00f3n del emisor impresa en el justificante (extra\u00edda por OCR+IA). Texto libre."
    },
    "forma_pago_documento": {
      "type": "string",
      "description": "Forma de pago impresa en el justificante (EFECTIVO, TARJETA, TRANSFERENCIA, etc.). Texto libre extra\u00eddo por OCR+IA; independiente del campo metodo_pago (reembolso)."
    },
    "tarjeta_ultimos_digitos": {
      "type": "string",
      "description": "Ultimos 4 digitos visibles de la tarjeta usada, si el documento muestra una tarjeta enmascarada (extraido por OCR+IA). Nunca el numero completo. Se cruza contra PatronTarjeta para sugerir origen_pago."
    },
    "hora_documento": {
      "type": "string",
      "description": "Hora impresa en el justificante (HH:MM), extra\u00edda por OCR+IA. Clave de detecci\u00f3n de duplicados: dos peajes de la misma autopista, mismo d\u00eda, mismo importe y mismo comercio pero a HORA distinta son documentos distintos (tramos sucesivos), no duplicados."
    },
    "origen_pago": {
      "type": "string",
      "enum": [
        "medios_propios",
        "medio_empresa",
        "credito_proveedor"
      ],
      "default": "medios_propios",
      "description": "Naturaleza del desembolso. medios_propios = el operario pag\u00f3 de su bolsillo y debe recuperarlo (reembolso, flujo cl\u00e1sico). medio_empresa = pagado con tarjeta/cuenta de la empresa, NO reembolsable, solo registro/seguimiento contable. credito_proveedor = factura a cr\u00e9dito/mensual del proveedor, sin desembolso directo del que la registra."
    },
    "duplicado_confirmado": {
      "default": false,
      "type": "boolean"
    },
    "es_gasto_tardio": {
      "default": false,
      "type": "boolean"
    },
    "es_posible_duplicado": {
      "default": false,
      "type": "boolean"
    },
    "estado": {
      "default": "borrador",
      "enum": [
        "borrador",
        "pendiente",
        "aprobado_gerencia",
        "registrado",
        "en_administracion",
        "pagada",
        "rechazada"
      ],
      "type": "string",
      "description": "borrador\u2192pendiente\u2192aprobado_gerencia\u2192en_administracion\u2192pagada (flujo reembolso, medios_propios). 'registrado' = entrada directa para facturas recibidas por la empresa (medio_empresa/credito_proveedor): nace aqu\u00ed sin pasar por borrador/aprobaci\u00f3n, pendiente de que contabilidad lo analice; luego promueve a en_administration. rechazada cancela."
    },
    "fecha_creacion_real": {
      "format": "date",
      "type": "string"
    },
    "fecha_documento": {
      "format": "date",
      "type": "string"
    },
    "fecha_validacion": {
      "format": "date",
      "type": "string"
    },
    "importe": {
      "type": "number"
    },
    "justificacion_tardia": {
      "type": "string",
      "description": "Motivo por el que el gasto se registra con m\u00e1s de 30 d\u00edas de retraso"
    },
    "nif_comercio": {
      "type": "string"
    },
    "nombre_comercio": {
      "type": "string"
    },
    "notas_admin": {
      "type": "string"
    },
    "numero_nota": {
      "type": "string"
    },
    "numero_secuencia": {
      "type": "integer"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    },
    "obra_tipo": {
      "enum": [
        "obra",
        "solar",
        "manual"
      ],
      "type": "string"
    },
    "ocr_raw": {
      "type": "string"
    },
    "ocr_status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "procesado",
        "error"
      ],
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "operario_email": {
      "type": "string",
      "description": "Email del usuario vinculado al operario (denormalizado para RLS y filtros r\u00e1pidos por usuario)"
    },
    "nota_mensual_id": {
      "type": "string",
      "description": "ID de la NotaMensualGasto a la que pertenece este registro (enlace al ciclo 26\u219225). Opcional para retrocompatibilidad con registros pre-migraci\u00f3n."
    },
    "ciclo_mes": {
      "type": "string",
      "description": "Clave mes YYYY-MM del ciclo al que pertenece (denormalizada de NotaMensualGasto.ciclo_mes para filtros r\u00e1\u00e1pidos)"
    },
    "orden_en_ciclo": {
      "type": "integer",
      "description": "N\u00famero secuencial del registro dentro del ciclo del operario (1, 2, 3...)."
    },
    "validado_por": {
      "type": "string"
    },
    "aprobado_por": {
      "type": "string",
      "description": "Email de quien aprob\u00f3 el gasto (gerencia, director_comercial o administracion)"
    },
    "fecha_aprobacion": {
      "type": "string",
      "description": "Fecha ISO de la aprobaci\u00f3n"
    },
    "pagado_por": {
      "type": "string",
      "description": "Email del administrador/gerencia que registr\u00f3 el pago"
    },
    "fecha_pago": {
      "type": "string",
      "description": "Fecha ISO en que se realiz\u00f3 el reembolso"
    },
    "importe_pagado_real": {
      "type": "number",
      "description": "Importe final pagado, puede diferir del original"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "transferencia",
        "efectivo",
        "tarjeta_empresa",
        "sepa"
      ]
    },
    "ia_no_disponible": {
      "type": "boolean",
      "default": false,
      "description": "True si la IA no pudo extraer datos del ticket al crear el registro \u2014 \u00fatil para auditor\u00eda"
    },
    "precisa_precision": {
      "type": "boolean",
      "default": false,
      "description": "True si el OCR primario (InvokeLLM modelo por defecto) devolvi\u00f3 confianza baja o faltan campos clave (importe, fecha_documento, nombre_comercio). Pendiente de re-procesamiento con modelo superior."
    },
    "precision_motivo": {
      "type": "string",
      "description": "Motivo por el que se marc\u00f3 precisa_precision (ej: 'confianza 0.4', 'falta importe y fecha')."
    },
    "precision_revisado_por": {
      "type": "string",
      "description": "Email del admin/gerencia que ejecut\u00f3 el re-procesamiento de precisi\u00f3n."
    },
    "precision_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha ISO en que se ejecut\u00f3 el re-procesamiento de precisi\u00f3n."
    },
    "precision_modelo_usado": {
      "type": "string",
      "description": "Modelo usado en el re-procesamiento de precisi\u00f3n (ej: 'gemini_3_flash')."
    },
    "precision_diff": {
      "type": "string",
      "description": "Auditor\u00eda antes/despu\u00e9s del re-procesamiento (campos corregidos o a\u00f1adidos)."
    },
    "proveedor_nif": {
      "type": "string",
      "description": "NIF/CIF del proveedor emisor del documento. Cuadrado por la gestor\u00eda (contabilidad) contra su sistema. Alias de nif_comercio para la vista de conciliaci\u00f3n."
    },
    "conciliado_contabilidad": {
      "type": "boolean",
      "default": false,
      "description": "Marca de conciliado por la gestor\u00eda (rol contabilidad). Solo la funci\u00f3n marcarConciliacionContable escribe este campo."
    },
    "fecha_conciliacion": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO en que la gestor\u00eda marc\u00f3 la conciliaci\u00f3n."
    },
    "conciliado_por": {
      "type": "string",
      "description": "Email del usuario contabilidad que marc\u00f3 la conciliaci\u00f3n."
    },
    "nota_conciliacion": {
      "type": "string",
      "description": "Anotaci\u00f3n libre de la gestor\u00eda (discrepancias, referencias contables)."
    },
    "estado_conciliacion": {
      "type": "string",
      "enum": [
        "no_conciliado",
        "conciliado",
        "conciliado_con_discrepancia"
      ],
      "default": "no_conciliado",
      "description": "Estado derivado de la conciliaci\u00f3n: no_conciliado \u2192 conciliado (limpio) | conciliado_con_discrepancia (genera AsistenteTarea para gerencia)."
    },
    "discrepancia_tarea_id": {
      "type": "string",
      "description": "ID de la AsistenteTarea de alta prioridad creada autom\u00e1ticamente al marcar conciliado_con_discrepancia (enlace al ciclo de resoluci\u00f3n)."
    },
    "resolucion_estado": {
      "type": "string",
      "enum": [
        "sin_discrepancia",
        "pendiente",
        "resuelta",
        "cerrada"
      ],
      "default": "sin_discrepancia",
      "description": "Ciclo de vida de la discrepancia: sin_discrepancia (conciliado limpio) \u2192 pendiente (tarea creada) \u2192 resuelta (gerencia actu\u00f3) \u2192 cerrada (contabilidad re-concilia limpio)."
    },
    "resolucion_por": {
      "type": "string",
      "description": "Email de gerencia/admin que cerr\u00f3 la discrepancia."
    },
    "fecha_resolucion": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO del cierre de la discrepancia."
    },
    "descargado_contabilidad": {
      "type": "boolean",
      "default": false,
      "description": "True si este documento ya se incluy\u00f3 en una descarga en bloque (ZIP/Excel) entregada a contabilidad. Evita duplicar trabajo de la gestor\u00eda."
    },
    "fecha_descarga": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO en que se incluy\u00f3 en una descarga en bloque."
    },
    "descargado_por": {
      "type": "string",
      "description": "Email de quien gener\u00f3 la descarga en bloque que incluy\u00f3 este documento."
    },
    "consolidado_ciclo": {
      "type": "boolean",
      "default": false,
      "description": "True si este documento ya forma parte de una NotaMensualGasto cerrada. Dato derivable de nota_mensual_id pero se explicita como flag de lectura r\u00e1pida para el sem\u00e1foro de trazabilidad."
    }
  },
  "required": [
    "operario_id",
    "categoria",
    "importe"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.origen_pago": {
                "$in": [
                  "medios_propios",
                  null
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.origen_pago": {
                "$in": [
                  "medio_empresa",
                  "credito_proveedor"
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "propietario"
                  }
                },
                {
                  "user_condition": {
                    "role": "gerencia"
                  }
                },
                {
                  "user_condition": {
                    "role": "administracion"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "contabilidad"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": {
                "$nin": [
                  "cerrada"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": "borrador"
            }
          ]
        }
      ]
    }
  }
}
