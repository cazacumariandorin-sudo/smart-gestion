{
  "name": "NotaGasto",
  "type": "object",
  "properties": {
    "numero_nota": {
      "type": "string",
      "description": "Autonum\u00e9rico NG-YYYY-MM-NNN"
    },
    "operario_id": {
      "type": "string",
      "description": "ID del operario"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario"
    },
    "periodo_mes": {
      "type": "string",
      "description": "Mes del periodo YYYY-MM"
    },
    "fecha_apertura": {
      "type": "string",
      "format": "date",
      "description": "Fecha apertura autom\u00e1tica"
    },
    "fecha_cierre": {
      "type": "string",
      "format": "date"
    },
    "cerrada_por": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "abierta",
        "pendiente_validacion",
        "validada",
        "cerrada",
        "rechazada"
      ],
      "default": "abierta"
    },
    "total_importes": {
      "type": "number",
      "default": 0,
      "description": "Suma calculada de todos los GastoOperario"
    },
    "num_registros": {
      "type": "integer",
      "default": 0
    },
    "notas_admin": {
      "type": "string"
    },
    "motivo_rechazo": {
      "type": "string"
    },
    "validado_por": {
      "type": "string"
    },
    "fecha_validacion": {
      "type": "string",
      "format": "date"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_name": {
      "type": "string"
    }
  },
  "required": [
    "operario_id",
    "operario_name",
    "periodo_mes"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.estado": "abierta"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}