{
  "name": "MaterialCatalog",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del material"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo / referencia (legacy \u2014 usar 'referencia' para nuevos OCR)"
    },
    "referencia": {
      "type": "string",
      "description": "C\u00f3digo de fabricante/proveedor (clave de matching OCR + fabricante)"
    },
    "fabricante_id": {
      "type": "string",
      "description": "ID del Fabricante"
    },
    "fabricante_name": {
      "type": "string",
      "description": "Nombre del fabricante (denormalizado)"
    },
    "category": {
      "type": "string",
      "description": "Categor\u00eda"
    },
    "unit": {
      "type": "string",
      "description": "Unidad de medida (m, kg, ud, m\u00b2, ...)"
    },
    "unit_price": {
      "type": "number",
      "description": "Precio unitario legacy \u2014 usar 'precio_neto' como lectura viva"
    },
    "pvp": {
      "type": "number",
      "description": "PVP p\u00fablico de venta (snapshot del \u00faltimo precio conocido)"
    },
    "descuento_empresa": {
      "type": "number",
      "description": "% descuento aplicado a Simantec (snapshot del \u00faltimo precio conocido)"
    },
    "iva": {
      "type": "number",
      "description": "% IVA aplicado (snapshot del \u00faltimo precio conocido)"
    },
    "precio_neto": {
      "type": "number",
      "description": "\u00daltimo precio neto conocido (snapshot del \u00faltimo MaterialPrecioHistorico). NO se edita manualmente: lo actualiza el backend al crear un nuevo hist\u00f3rico."
    },
    "fecha_ultimo_precio": {
      "type": "string",
      "format": "date",
      "description": "Fecha del \u00faltimo precio registrado (snapshot)"
    },
    "supplier": {
      "type": "string",
      "description": "Proveedor (legacy \u2014 ahora vinculable a Fabricante)"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n / especificaciones"
    },
    "manual_url": {
      "type": "string",
      "description": "URL del manual / ficha t\u00e9cnica"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}