{
  "name": "MaterialCatalog",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del material"
    },
    "code": {
      "type": "string",
      "description": "Código / referencia (legacy — usar 'referencia' para nuevos OCR)"
    },
    "referencia": {
      "type": "string",
      "description": "Código de fabricante/proveedor (clave de matching OCR + fabricante)"
    },
    "fabricante_id": {
      "type": "string",
      "description": "ID del Fabricante"
    },
    "fabricante_name": {
      "type": "string",
      "description": "Nombre del fabricante (denormalizado)"
    },
    "category": {
      "type": "string",
      "description": "Categoría"
    },
    "unit": {
      "type": "string",
      "description": "Unidad de medida (m, kg, ud, m², ...)"
    },
    "unit_price": {
      "type": "number",
      "description": "Precio unitario legacy — usar 'precio_neto' como lectura viva"
    },
    "pvp": {
      "type": "number",
      "description": "PVP público de venta (snapshot del último precio conocido)"
    },
    "descuento_empresa": {
      "type": "number",
      "description": "% descuento aplicado a Simantec (snapshot del último precio conocido)"
    },
    "iva": {
      "type": "number",
      "description": "% IVA aplicado (snapshot del último precio conocido)"
    },
    "precio_neto": {
      "type": "number",
      "description": "Último precio neto conocido (snapshot del último MaterialPrecioHistorico). NO se edita manualmente: lo actualiza el backend al crear un nuevo histórico."
    },
    "fecha_ultimo_precio": {
      "type": "string",
      "format": "date",
      "description": "Fecha del último precio registrado (snapshot)"
    },
    "supplier": {
      "type": "string",
      "description": "Proveedor (legacy — ahora vinculable a Fabricante)"
    },
    "description": {
      "type": "string",
      "description": "Descripción / especificaciones"
    },
    "manual_url": {
      "type": "string",
      "description": "URL del manual / ficha técnica"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
