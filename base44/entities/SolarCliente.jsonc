{
  "name": "SolarCliente",
  "properties": {
    "active": {
      "default": true,
      "type": "boolean"
    },
    "address": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "nif": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "tipo": {
      "default": "particular",
      "enum": [
        "particular",
        "empresa",
        "comunidad"
      ],
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}