{
  "name": "GastoOperario",
  "type": "object",
  "properties": {
    "nota_id": {
      "type": "string",
      "description": "ID de la NotaGasto a la que pertenece"
    },
    "numero_registro": {
      "type": "string",
      "description": "Autonum\u00e9rico dentro de la nota: R-001, R-002..."
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del gasto"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "combustible",
        "comida",
        "material",
        "peaje",
        "parking",
        "varios"
      ]
    },
    "importe": {
      "type": "number",
      "minimum": 0.01
    },
    "descripcion": {
      "type": "string"
    },
    "proveedor": {
      "type": "string"
    },
    "ticket_url": {
      "type": "string"
    },
    "ticket_thumbnail_url": {
      "type": "string"
    },
    "ticket_requerido": {
      "type": "boolean",
      "default": true
    },
    "ocr_raw": {
      "type": "string"
    },
    "ocr_status": {
      "type": "string",
      "enum": [
        "pendiente",
        "procesado",
        "validado",
        "error"
      ],
      "default": "pendiente"
    },
    "work_order_id": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "description": "Obra vinculada (nombre)"
    },
    "obra_id": {
      "type": "string"
    },
    "estado_aprobacion": {
      "type": "string",
      "enum": [
        "pendiente",
        "aprobado",
        "rechazado"
      ],
      "default": "pendiente"
    },
    "aprobado_por": {
      "type": "string"
    },
    "fecha_aprobacion": {
      "type": "string",
      "format": "date"
    },
    "motivo_rechazo": {
      "type": "string"
    },
    "es_posible_duplicado": {
      "type": "boolean",
      "default": false
    },
    "duplicado_confirmado": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "nota_id",
    "operario_id",
    "operario_name",
    "date",
    "categoria",
    "importe",
    "descripcion"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}