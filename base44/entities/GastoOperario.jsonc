{
  "name": "GastoOperario",
  "properties": {
    "aprobado_por": {
      "type": "string"
    },
    "categoria": {
      "enum": [
        "combustible",
        "comida",
        "material",
        "varios",
        "peaje",
        "parking"
      ],
      "type": "string"
    },
    "date": {
      "format": "date",
      "minimum": "2024-01-01",
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "estado_aprobacion": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "aprobado",
        "rechazado"
      ],
      "type": "string"
    },
    "fecha_aprobacion": {
      "format": "date",
      "type": "string"
    },
    "importe": {
      "maximum": 5000,
      "minimum": 0.01,
      "type": "number"
    },
    "motivo_rechazo": {
      "type": "string"
    },
    "nota_id": {
      "type": "string"
    },
    "ocr_raw": {
      "type": "string"
    },
    "ocr_status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "procesado",
        "validado",
        "error"
      ],
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "proveedor": {
      "type": "string"
    },
    "ticket_requerido": {
      "default": true,
      "type": "boolean"
    },
    "ticket_url": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    }
  },
  "required": [
    "nota_id",
    "operario_id",
    "operario_name",
    "date",
    "categoria",
    "importe",
    "descripcion"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}