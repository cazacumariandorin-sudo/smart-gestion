{
  "name": "GastoOperario",
  "type": "object",
  "properties": {
    "nota_id": {
      "type": "string",
      "description": "ID de la nota de gastos a la que pertenece"
    },
    "operario_id": {
      "type": "string",
      "description": "ID del operario"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del gasto (no puede ser anterior a 2024-01-01)",
      "minimum": "2024-01-01"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "combustible",
        "comida",
        "material",
        "varios",
        "peaje",
        "parking"
      ],
      "description": "Categor\u00eda del gasto"
    },
    "importe": {
      "type": "number",
      "description": "Importe (\u20ac)",
      "minimum": 0.01,
      "maximum": 5000
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n / concepto del gasto"
    },
    "proveedor": {
      "type": "string",
      "description": "Proveedor / establecimiento"
    },
    "ticket_url": {
      "type": "string",
      "description": "URL foto ticket/factura"
    },
    "ticket_requerido": {
      "type": "boolean",
      "default": true,
      "description": "Indica si esta categor\u00eda requiere ticket obligatorio"
    },
    "ocr_raw": {
      "type": "string",
      "description": "Texto extra\u00eddo por OCR del ticket"
    },
    "ocr_status": {
      "type": "string",
      "enum": [
        "pendiente",
        "procesado",
        "validado",
        "error"
      ],
      "default": "pendiente",
      "description": "Estado del procesamiento OCR"
    },
    "work_order_id": {
      "type": "string",
      "description": "Parte de trabajo asociado (opcional)"
    },
    "project": {
      "type": "string",
      "description": "Obra (opcional)"
    },
    "estado_aprobacion": {
      "type": "string",
      "enum": [
        "pendiente",
        "aprobado",
        "rechazado"
      ],
      "default": "pendiente",
      "description": "Estado de aprobaci\u00f3n del gasto"
    },
    "aprobado_por": {
      "type": "string",
      "description": "Email del usuario que aprob\u00f3 o rechaz\u00f3 el gasto"
    },
    "fecha_aprobacion": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se aprob\u00f3 o rechaz\u00f3"
    },
    "motivo_rechazo": {
      "type": "string",
      "description": "Motivo del rechazo si estado_aprobacion = rechazado"
    }
  },
  "required": [
    "nota_id",
    "operario_id",
    "operario_name",
    "date",
    "categoria",
    "importe",
    "descripcion"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}