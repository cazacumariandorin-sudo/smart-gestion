{
  "name": "AlertaVehiculo",
  "type": "object",
  "properties": {
    "descripcion": {
      "description": "Descripci\u00f3n detallada de la alerta",
      "type": "string"
    },
    "fecha": {
      "description": "Fecha de la alerta",
      "format": "date",
      "type": "string"
    },
    "fecha_resolucion": {
      "description": "Fecha en que se resolvi\u00f3",
      "format": "date",
      "type": "string"
    },
    "fecha_archivado": {
      "description": "Fecha en que el aviso se archiv\u00f3 autom\u00e1ticamente (repostajes: 23:59 del d\u00eda)",
      "format": "date",
      "type": "string"
    },
    "km_actuales": {
      "description": "Km del veh\u00edculo cuando se gener\u00f3 la alerta",
      "type": "number"
    },
    "km_limite": {
      "description": "Km l\u00edmite que activ\u00f3 la alerta",
      "type": "number"
    },
    "notas_resolucion": {
      "description": "Notas al resolver",
      "type": "string"
    },
    "resuelta": {
      "default": false,
      "description": "Si la alerta ha sido atendida",
      "type": "boolean"
    },
    "resuelta_por": {
      "description": "Email del usuario que resolvi\u00f3",
      "type": "string"
    },
    "tipo": {
      "description": "Tipo de alerta",
      "enum": [
        "itv_proxima",
        "itv_caducada",
        "aceite_km",
        "aceite_fecha",
        "neumaticos_km",
        "filtros_km",
        "filtros_fecha",
        "ac_revision",
        "velocidad_exceso",
        "mantenimiento_general",
        "averia_motor",
        "averia_frenos",
        "averia_electrica",
        "testigo_panel",
        "otra_incidencia",
        "repostaje"
      ],
      "type": "string"
    },
    "urgencia": {
      "default": "media",
      "description": "Nivel de urgencia",
      "enum": [
        "baja",
        "media",
        "alta",
        "critica"
      ],
      "type": "string"
    },
    "vehiculo_id": {
      "description": "ID del veh\u00edculo",
      "type": "string"
    },
    "vehiculo_matricula": {
      "description": "Matr\u00edcula del veh\u00edculo",
      "type": "string"
    },
    "vehiculo_modelo": {
      "description": "Modelo del veh\u00edculo",
      "type": "string"
    },
    "avisos_visible": {
      "default": true,
      "description": "Si el aviso sigue visible para todos los usuarios. En repostajes, se pone false al archivarse a las 23:59; una vez archivado, el registro solo lo ven gerencia/admin.",
      "type": "boolean"
    },
    "reportada_por_nombre": {
      "description": "Nombre de quien report\u00f3 la incidencia / repostaje",
      "type": "string"
    },
    "lugar": {
      "description": "Lugar gen\u00e9rico del aviso (ej. repostaje: Gasolinera, En obra, Almac\u00e9n...)",
      "type": "string"
    }
  },
  "required": [
    "vehiculo_id",
    "vehiculo_matricula",
    "tipo",
    "fecha"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    }
  }
}