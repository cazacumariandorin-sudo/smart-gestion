{
  "name": "AlertaVehiculo",
  "type": "object",
  "properties": {
    "descripcion": {
      "description": "Descripción detallada de la alerta",
      "type": "string"
    },
    "fecha": {
      "description": "Fecha de la alerta",
      "format": "date",
      "type": "string"
    },
    "fecha_resolucion": {
      "description": "Fecha en que se resolvió",
      "format": "date",
      "type": "string"
    },
    "fecha_archivado": {
      "description": "Fecha en que el aviso se archivó automáticamente (repostajes: 23:59 del día)",
      "format": "date",
      "type": "string"
    },
    "km_actuales": {
      "description": "Km del vehículo cuando se generó la alerta",
      "type": "number"
    },
    "km_limite": {
      "description": "Km límite que activó la alerta",
      "type": "number"
    },
    "notas_resolucion": {
      "description": "Notas al resolver",
      "type": "string"
    },
    "resuelta": {
      "default": false,
      "description": "Si la alerta ha sido atendida",
      "type": "boolean"
    },
    "resuelta_por": {
      "description": "Email del usuario que resolvió",
      "type": "string"
    },
    "tipo": {
      "description": "Tipo de alerta",
      "enum": [
        "itv_proxima",
        "itv_caducada",
        "aceite_km",
        "aceite_fecha",
        "neumaticos_km",
        "filtros_km",
        "filtros_fecha",
        "ac_revision",
        "velocidad_exceso",
        "mantenimiento_general",
        "averia_motor",
        "averia_frenos",
        "averia_electrica",
        "testigo_panel",
        "otra_incidencia",
        "repostaje"
      ],
      "type": "string"
    },
    "urgencia": {
      "default": "media",
      "description": "Nivel de urgencia",
      "enum": [
        "baja",
        "media",
        "alta",
        "critica"
      ],
      "type": "string"
    },
    "vehiculo_id": {
      "description": "ID del vehículo",
      "type": "string"
    },
    "vehiculo_matricula": {
      "description": "Matrícula del vehículo",
      "type": "string"
    },
    "vehiculo_modelo": {
      "description": "Modelo del vehículo",
      "type": "string"
    },
    "avisos_visible": {
      "default": true,
      "description": "Si el aviso sigue visible para todos los usuarios. En repostajes, se pone false al archivarse a las 23:59; una vez archivado, el registro solo lo ven gerencia/admin.",
      "type": "boolean"
    },
    "reportada_por_nombre": {
      "description": "Nombre de quien reportó la incidencia / repostaje",
      "type": "string"
    },
    "lugar": {
      "description": "Lugar genérico del aviso (ej. repostaje: Gasolinera, En obra, Almacén...)",
      "type": "string"
    }
  },
  "required": [
    "vehiculo_id",
    "vehiculo_matricula",
    "tipo",
    "fecha"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "director_comercial"
              }
            },
            {
              "$or": [
                {
                  "data.tipo": {
                    "$nin": [
                      "repostaje"
                    ]
                  }
                },
                {
                  "data.avisos_visible": {
                    "$nin": [
                      false
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "jefe_obra"
              }
            },
            {
              "$or": [
                {
                  "data.tipo": {
                    "$nin": [
                      "repostaje"
                    ]
                  }
                },
                {
                  "data.avisos_visible": {
                    "$nin": [
                      false
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "técnico"
              }
            },
            {
              "$or": [
                {
                  "data.tipo": {
                    "$nin": [
                      "repostaje"
                    ]
                  }
                },
                {
                  "data.avisos_visible": {
                    "$nin": [
                      false
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "operario"
              }
            },
            {
              "$or": [
                {
                  "data.tipo": {
                    "$nin": [
                      "repostaje"
                    ]
                  }
                },
                {
                  "data.avisos_visible": {
                    "$nin": [
                      false
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "$or": [
                {
                  "data.tipo": {
                    "$nin": [
                      "repostaje"
                    ]
                  }
                },
                {
                  "data.avisos_visible": {
                    "$nin": [
                      false
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    }
  }
}
