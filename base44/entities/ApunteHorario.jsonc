{
  "name": "ApunteHorario",
  "type": "object",
  "properties": {
    "operario_id": {
      "type": "string",
      "description": "ID del operario"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del apunte"
    },
    "obra_id": {
      "type": "string",
      "description": "ID de la obra (FK a Obra o SolarObra)"
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "concepto": {
      "type": "string",
      "description": "Concepto / descripci\u00f3n del trabajo"
    },
    "unidad": {
      "type": "string",
      "description": "Unidad de medida (m, m\u00b2, m\u00b3, ud, kg...)"
    },
    "cantidad": {
      "type": "number",
      "description": "Cantidad realizada"
    },
    "precio_unitario": {
      "type": "number",
      "description": "Precio unitario (\u20ac)"
    },
    "total": {
      "type": "number",
      "description": "Total (\u20ac)"
    },
    "horas_ejecutadas": {
      "type": "number",
      "description": "Horas reales en este apunte"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "operario_id",
    "date",
    "concepto",
    "cantidad",
    "obra_id",
    "obra_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "jefe_obra"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "jefe_obra"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}