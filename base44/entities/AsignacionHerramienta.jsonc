{
  "name": "AsignacionHerramienta",
  "type": "object",
  "properties": {
    "herramienta_id": {
      "type": "string",
      "description": "ID de la herramienta"
    },
    "herramienta_nombre": {
      "type": "string",
      "description": "Nombre de la herramienta (copia)"
    },
    "operario_id": {
      "type": "string",
      "description": "ID del operario"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario (copia)"
    },
    "fecha_asignacion": {
      "type": "string",
      "format": "date",
      "description": "Fecha de asignación"
    },
    "fecha_devolucion": {
      "type": "string",
      "format": "date",
      "description": "Fecha de devolución (null si sigue en uso)"
    },
    "estado_asignacion": {
      "type": "string",
      "enum": [
        "asignada",
        "devuelta",
        "perdida",
        "dañada"
      ],
      "default": "asignada",
      "description": "Estado de la asignación"
    },
    "obra_id": {
      "type": "string",
      "description": "Obra donde se usa (opcional)"
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones sobre el uso"
    }
  },
  "required": [
    "herramienta_id",
    "operario_id",
    "fecha_asignacion"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "operario"
              }
            },
            {
              "data.operario_name": "{{user.full_name}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
