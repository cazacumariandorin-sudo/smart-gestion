{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "client_id": {
      "description": "ID del cliente (obligatorio para RLS de cliente_obra)",
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "firma_cliente": {
      "description": "Firma del cliente en base64 o URL",
      "type": "string"
    },
    "firma_cliente_fecha": {
      "description": "Fecha y hora de firma del cliente",
      "format": "date-time",
      "type": "string"
    },
    "firma_cliente_ip": {
      "description": "IP desde la que firm\u00f3 el cliente",
      "type": "string"
    },
    "firma_cliente_nif": {
      "description": "NIF del firmante cliente",
      "type": "string"
    },
    "firma_cliente_nombre": {
      "description": "Nombre completo del firmante cliente",
      "type": "string"
    },
    "firma_operario": {
      "description": "Firma del operario en base64 o URL",
      "type": "string"
    },
    "firma_operario_fecha": {
      "description": "Fecha y hora de firma del operario",
      "format": "date-time",
      "type": "string"
    },
    "firma_pdf_url": {
      "description": "URL del PDF firmado generado",
      "type": "string"
    },
    "firma_status": {
      "default": "sin_firmar",
      "description": "Estado del proceso de firma",
      "enum": [
        "sin_firmar",
        "pendiente_cliente",
        "pendiente_tecnico",
        "firmado_tecnico",
        "firmado_ambos",
        "rechazado"
      ],
      "type": "string"
    },
    "firma_token": {
      "description": "Token \u00fanico para enlace de firma remota del cliente",
      "type": "string"
    },
    "firma_token_expiry": {
      "description": "Fecha de expiraci\u00f3n del token de firma",
      "format": "date-time",
      "type": "string"
    },
    "hora_fin": {
      "type": "string"
    },
    "hora_inicio": {
      "type": "string"
    },
    "materials": {
      "items": {
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "type": "string"
    },
    "obra_id": {
      "description": "ID de la obra vinculada",
      "type": "string"
    },
    "vehiculo_id": {
      "description": "ID del veh\u00edculo utilizado para el desplazamiento (opcional)",
      "type": "string"
    },
    "vehiculo_matricula": {
      "description": "Matr\u00edcula del veh\u00edculo (desnormalizada, opcional)",
      "type": "string"
    },
    "desplazamiento_tipo": {
      "description": "Tipo de desplazamiento realizado (opcional)",
      "enum": [
        "desplazamiento",
        "traslado",
        "compras",
        "otro"
      ],
      "type": "string"
    },
    "desplazamiento_valor": {
      "description": "Valor del desplazamiento en km (opcional, informativo)",
      "type": "number"
    },
    "desplazamiento_importe_eur": {
      "description": "Importe econ\u00f3mico del desplazamiento en euros (opcional). Calculado autom\u00e1ticamente como km \u00d7 tarifa de la empresa al registrar el parte.",
      "type": "number"
    },
    "order_number": {
      "description": "N\u00famero de parte generado autom\u00e1ticamente",
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "signaturit_document_id": {
      "description": "ID del documento en Signaturit",
      "type": "string"
    },
    "signaturit_status": {
      "description": "Estado en la plataforma Signaturit",
      "type": "string"
    },
    "status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "en_curso",
        "completado"
      ],
      "type": "string"
    },
    "total_hours": {
      "type": "number"
    },
    "workers": {
      "items": {
        "properties": {
          "hours": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "date",
    "project"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "user_condition": {
            "role": "control_horario"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "cliente_obra"
              }
            },
            {
              "data.client_id": "{{user.vinculo_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    }
  }
}