{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero de orden de trabajo"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del parte de trabajo"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente (copia)"
    },
    "project": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del trabajo realizado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_curso",
        "completado"
      ],
      "default": "pendiente",
      "description": "Estado del parte"
    },
    "hora_inicio": {
      "type": "string",
      "description": "Hora de inicio del trabajo (HH:MM)"
    },
    "hora_fin": {
      "type": "string",
      "description": "Hora de fin del trabajo (HH:MM)"
    },
    "workers": {
      "type": "array",
      "description": "Operarios asignados",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "description": "Materiales utilizados",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "total_hours": {
      "type": "number",
      "description": "Total de horas trabajadas"
    },
    "firma_operario": {
      "type": "string",
      "description": "URL imagen firma del operario"
    },
    "firma_cliente": {
      "type": "string",
      "description": "URL imagen firma del cliente"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones adicionales"
    }
  },
  "required": [
    "date",
    "project"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}