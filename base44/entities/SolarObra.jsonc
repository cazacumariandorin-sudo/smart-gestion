{
  "name": "SolarObra",
  "properties": {
    "address": {
      "type": "string"
    },
    "attached_files": {
      "items": {
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "budget": {
      "type": "number"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "num_paneles": {
      "type": "number"
    },
    "potencia_kw": {
      "type": "number"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "presupuesto",
      "enum": [
        "presupuesto",
        "activa",
        "pausada",
        "finalizada"
      ],
      "type": "string"
    },
    "tipo_instalacion": {
      "enum": [
        "autoconsumo",
        "vertido_red",
        "aislada",
        "hibrida"
      ],
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}