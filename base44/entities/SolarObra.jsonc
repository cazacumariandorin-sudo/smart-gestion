{
  "name": "SolarObra",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la obra solar"
    },
    "code": {
      "type": "string",
      "description": "Código / referencia interna"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente solar"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente solar"
    },
    "address": {
      "type": "string",
      "description": "Dirección de la instalación"
    },
    "potencia_kw": {
      "type": "number",
      "description": "Potencia instalada (kW)"
    },
    "num_paneles": {
      "type": "number",
      "description": "Número de paneles"
    },
    "tipo_instalacion": {
      "type": "string",
      "enum": [
        "autoconsumo",
        "vertido_red",
        "aislada",
        "hibrida"
      ],
      "description": "Tipo de instalación solar"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin prevista"
    },
    "status": {
      "type": "string",
      "enum": [
        "presupuesto",
        "activa",
        "pausada",
        "finalizada"
      ],
      "default": "presupuesto",
      "description": "Estado de la obra solar"
    },
    "budget": {
      "type": "number",
      "description": "Presupuesto (€)"
    },
    "contact_person": {
      "type": "string",
      "description": "Persona de contacto"
    },
    "contact_phone": {
      "type": "string",
      "description": "Teléfono de contacto"
    },
    "description": {
      "type": "string",
      "description": "Descripción / alcance"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "attached_files": {
      "type": "array",
      "description": "Archivos adjuntos",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}
