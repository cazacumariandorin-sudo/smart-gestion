{
  "name": "SolarObra",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la obra solar"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo / referencia interna"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente solar"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente solar"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n de la instalaci\u00f3n"
    },
    "potencia_kw": {
      "type": "number",
      "description": "Potencia instalada (kW)"
    },
    "num_paneles": {
      "type": "number",
      "description": "N\u00famero de paneles"
    },
    "tipo_instalacion": {
      "type": "string",
      "enum": [
        "autoconsumo",
        "vertido_red",
        "aislada",
        "hibrida"
      ],
      "description": "Tipo de instalaci\u00f3n solar"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin prevista"
    },
    "status": {
      "type": "string",
      "enum": [
        "presupuesto",
        "activa",
        "pausada",
        "finalizada"
      ],
      "default": "presupuesto",
      "description": "Estado de la obra solar"
    },
    "budget": {
      "type": "number",
      "description": "Presupuesto (\u20ac)"
    },
    "contact_person": {
      "type": "string",
      "description": "Persona de contacto"
    },
    "contact_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n / alcance"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "attached_files": {
      "type": "array",
      "description": "Archivos adjuntos",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "clientes_acceso": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails de usuarios con rol cliente_obra autorizados a leer esta obra solar. Lo mantiene la pantalla Usuarios > Obras asignadas y la regla de lectura lo usa para limitar el acceso del cliente a sus obras."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "user_condition": {
            "role": "contabilidad"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "cliente_obra"
              }
            },
            {
              "data.clientes_acceso": "{{user.email}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}