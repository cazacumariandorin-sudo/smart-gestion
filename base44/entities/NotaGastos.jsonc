{
  "name": "NotaGastos",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo de la nota de gastos"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del gasto"
    },
    "concepto": {
      "type": "string",
      "enum": [
        "gasolina",
        "parking",
        "material",
        "peaje",
        "otro"
      ],
      "description": "Categor\u00eda del gasto"
    },
    "importe": {
      "type": "number",
      "description": "Importe en \u20ac"
    },
    "cif": {
      "type": "string",
      "description": "CIF/NIF del proveedor"
    },
    "proveedor": {
      "type": "string",
      "description": "Nombre del proveedor"
    },
    "direccion": {
      "type": "string",
      "description": "Direcci\u00f3n del proveedor"
    },
    "codigo_postal": {
      "type": "string",
      "description": "C\u00f3digo postal"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n detallada del gasto"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "archivos": {
      "type": "array",
      "description": "Archivos adjuntos (tickets, facturas, fotos)",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "fecha_subida": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "aprobado",
        "rechazado"
      ],
      "default": "pendiente",
      "description": "Estado de la nota"
    }
  },
  "required": [
    "titulo",
    "concepto",
    "importe"
  ]
}