{
  "name": "DatosSensiblesUsuario",
  "type": "object",
  "description": "Datos personales y econ\u00f3micos del trabajador (DNI, IBAN, salario, contrato). Aislado por empresa: solo la empresa del trabajador, su propio usuario y el propietario pueden leerlo.",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "Empresa a la que pertenece el trabajador. Frontera de aislamiento de la ficha."
    },
    "empresa_nombre": {
      "type": "string",
      "description": "Nombre de la empresa (desnormalizado)."
    },
    "user_email": {
      "type": "string",
      "description": "ANCLA \u00daNICA \u2014 Email del usuario de la app vinculado. Nunca debe duplicarse."
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario de la app (User.id)"
    },
    "operario_id": {
      "type": "string",
      "description": "ID del registro Operario vinculado (referencia cruzada)"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario (desnormalizado para lectura r\u00e1pida)"
    },
    "dni_nie": {
      "type": "string",
      "description": "DNI o NIE del trabajador \u2014 almacenado cifrado (AES-256-GCM)"
    },
    "num_afiliacion_ss": {
      "type": "string",
      "description": "N\u00famero de afiliaci\u00f3n a la Seguridad Social \u2014 almacenado cifrado (AES-256-GCM)"
    },
    "cuenta_bancaria_iban": {
      "type": "string",
      "description": "IBAN o n\u00famero de cuenta bancaria para n\u00f3mina \u2014 almacenado cifrado (AES-256-GCM)"
    },
    "coste_hora": {
      "type": "string",
      "description": "Coste por hora en EUR \u2014 almacenado cifrado (AES-256-GCM). Solo visible para admin/gerencia/administracion tras descifrar."
    },
    "salario_bruto_mensual": {
      "type": "string",
      "description": "Salario bruto mensual en EUR \u2014 almacenado cifrado (AES-256-GCM)"
    },
    "categoria_laboral": {
      "type": "string",
      "enum": [
        "oficial_primera",
        "oficial_segunda",
        "peon",
        "encargado",
        "tecnico_solar",
        "administrativo",
        "subcontrata",
        "temporal"
      ],
      "description": "Categor\u00eda laboral oficial (convenio)"
    },
    "fecha_alta_empresa": {
      "type": "string",
      "format": "date",
      "description": "Fecha de alta en la empresa"
    },
    "fecha_baja_empresa": {
      "type": "string",
      "format": "date",
      "description": "Fecha de baja (si aplica)"
    },
    "contrato_url": {
      "type": "string",
      "description": "URL del contrato de trabajo (archivo privado)"
    },
    "documentacion_adjunta": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "description": "Tipo de documento (TC2, IRPF, certificado m\u00e9dico...)"
          },
          "url": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "nombre": {
            "type": "string"
          }
        }
      },
      "description": "Documentos privados del trabajador"
    },
    "notas_confidenciales": {
      "type": "string",
      "description": "Notas internas de gerencia \u2014 almacenado cifrado (AES-256-GCM)"
    },
    "migrado_desde_operario": {
      "type": "boolean",
      "default": false,
      "description": "True si este registro fue creado por migraci\u00f3n autom\u00e1tica desde Operario"
    },
    "fecha_migracion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se realiz\u00f3 la migraci\u00f3n de datos"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            },
            {
              "user_condition": {
                "role": "administracion"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            },
            {
              "user_condition": {
                "role": "administracion"
              }
            },
            {
              "data.user_email": "{{user.email}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "user_condition": {
                "role": "gerencia"
              }
            },
            {
              "user_condition": {
                "role": "administracion"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "es_propietario_global": true
              }
            },
            {
              "user_condition": {
                "role": "propietario"
              }
            },
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            }
          ]
        }
      ]
    }
  }
}