{
  "name": "NotificacionFichaje",
  "type": "object",
  "properties": {
    "operario_id": {
      "type": "string",
      "description": "ID del operario"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del evento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "sin_salida",
        "sin_fichaje"
      ],
      "description": "Tipo de alerta"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción de la alerta"
    },
    "visto": {
      "type": "boolean",
      "default": false,
      "description": "Si el admin vio la notificación"
    },
    "resuelto": {
      "type": "boolean",
      "default": false,
      "description": "Si se resolvió manualmente"
    }
  },
  "required": [
    "operario_id",
    "date",
    "tipo"
  ],
  "rls": {
    "create": {
      "data.operario_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "data.operario_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
