{
  "name": "SolicitudPrivilegio",
  "type": "object",
  "description": "Solicitud de privilegios que una empresa dirige al propietario de la app: un usuario con rol demo o con un rol insuficiente necesita m\u00e1s permisos en el espacio de esa empresa. Recoge qui\u00e9n lo pide, a qui\u00e9n afecta, el rol solicitado, el motivo y la decisi\u00f3n del propietario, con historial completo. La aprobaci\u00f3n autoriza el cambio: el rol se aplica en el espacio de la empresa solicitante y solo all\u00ed.",
  "properties": {
    "espacio_id": {
      "type": "string",
      "description": "ID del EspacioEmpresa al que corresponde la solicitud."
    },
    "empresa_id": {
      "type": "string",
      "description": "ID de la empresa que solicita."
    },
    "empresa_nombre": {
      "type": "string",
      "description": "Nombre de la empresa solicitante (desnormalizado)."
    },
    "solicitante_email": {
      "type": "string",
      "description": "Email del administrador local que presenta la solicitud."
    },
    "solicitante_nombre": {
      "type": "string",
      "description": "Nombre del solicitante (desnormalizado)."
    },
    "usuario_email": {
      "type": "string",
      "description": "Email del usuario al que afecta el cambio de rol."
    },
    "usuario_nombre": {
      "type": "string",
      "description": "Nombre del usuario afectado (desnormalizado)."
    },
    "rol_actual": {
      "type": "string",
      "description": "Rol que tiene el usuario en ese espacio en el momento de la solicitud."
    },
    "rol_solicitado": {
      "type": "string",
      "description": "Rol que la empresa solicita para ese usuario."
    },
    "motivo": {
      "type": "string",
      "description": "Motivo de la solicitud: por qu\u00e9 necesita esos privilegios."
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "aprobada",
        "rechazada",
        "aplicada",
        "anulada"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "blue",
        "gray"
      ],
      "default": "pendiente",
      "description": "pendiente = espera decisi\u00f3n del propietario; aprobada = autorizada, pendiente de aplicar en el espacio; rechazada = denegada; aplicada = el rol ya se cambi\u00f3 en el espacio de la empresa; anulada = retirada antes de decidir."
    },
    "decidido_por": {
      "type": "string",
      "description": "Email del propietario que tom\u00f3 la decisi\u00f3n."
    },
    "decidido_en": {
      "type": "string",
      "format": "date-time",
      "description": "Momento de la decisi\u00f3n."
    },
    "comentario_decision": {
      "type": "string",
      "description": "Motivo o condiciones de la decisi\u00f3n."
    },
    "aplicado_por": {
      "type": "string",
      "description": "Email de quien aplic\u00f3 el cambio de rol en el espacio de la empresa."
    },
    "aplicado_en": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que el rol qued\u00f3 aplicado."
    },
    "historial": {
      "type": "array",
      "description": "Trazabilidad de la solicitud: alta, decisiones y aplicaci\u00f3n.",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "usuario_email": {
            "type": "string"
          },
          "accion": {
            "type": "string"
          },
          "estado_anterior": {
            "type": "string"
          },
          "estado_nuevo": {
            "type": "string"
          },
          "nota": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "empresa_nombre",
    "usuario_email",
    "rol_solicitado",
    "estado"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}