{
  "name": "Vacacion",
  "properties": {
    "aprobado": {
      "default": false,
      "type": "boolean"
    },
    "dias": {
      "type": "number"
    },
    "fecha_fin": {
      "format": "date",
      "type": "string"
    },
    "fecha_inicio": {
      "format": "date",
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "operario_id": {
      "type": "string"
    },
    "operario_name": {
      "type": "string"
    },
    "tipo": {
      "enum": [
        "vacaciones",
        "baja_medica",
        "dia_asunto_personal",
        "fiesta",
        "vacaciones_convenio"
      ],
      "type": "string"
    }
  },
  "required": [
    "operario_id",
    "fecha_inicio",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.aprobado": false
            }
          ]
        }
      ]
    }
  },
  "type": "object"
}