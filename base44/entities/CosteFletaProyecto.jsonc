{
  "name": "CosteFletaProyecto",
  "type": "object",
  "properties": {
    "coste_combustible_total": {
      "description": "Coste total en combustible (€)",
      "type": "number"
    },
    "coste_por_km": {
      "description": "Coste por km usado para el cálculo (€/km)",
      "type": "number"
    },
    "coste_total_estimado": {
      "description": "Coste total estimado de desplazamientos (€)",
      "type": "number"
    },
    "fecha_calculo": {
      "description": "Fecha del último cálculo",
      "format": "date",
      "type": "string"
    },
    "km_totales": {
      "description": "Km totales acumulados en el proyecto",
      "type": "number"
    },
    "mes": {
      "description": "Mes del cálculo (YYYY-MM)",
      "type": "string"
    },
    "num_viajes": {
      "description": "Número de viajes al proyecto",
      "type": "number"
    },
    "proyecto_id": {
      "description": "ID del proyecto",
      "type": "string"
    },
    "proyecto_nombre": {
      "description": "Nombre del proyecto",
      "type": "string"
    },
    "vehiculos_implicados": {
      "description": "Matrículas de vehículos que han ido a este proyecto",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "proyecto_id",
    "mes"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    }
  }
}
