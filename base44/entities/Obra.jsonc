{
  "name": "Obra",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "code": {
      "type": "string",
      "description": "Código / referencia interna"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "address": {
      "type": "string",
      "description": "Dirección de la obra"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin prevista"
    },
    "status": {
      "type": "string",
      "enum": [
        "activa",
        "pausada",
        "finalizada",
        "presupuesto"
      ],
      "default": "activa",
      "description": "Estado de la obra"
    },
    "budget": {
      "type": "number",
      "description": "Presupuesto (€)"
    },
    "description": {
      "type": "string",
      "description": "Descripción / alcance"
    },
    "contact_person": {
      "type": "string",
      "description": "Persona de contacto en obra"
    },
    "contact_phone": {
      "type": "string",
      "description": "Teléfono de contacto"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        },
        {
          "user_condition": {
            "role": "control_horario"
          }
        },
        {
          "user_condition": {
            "role": "cliente_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}
