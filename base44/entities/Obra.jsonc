{
  "name": "Obra",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la obra"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo / referencia interna"
    },
    "numero_proyecto": {
      "type": "string",
      "description": "N\u00famero de proyecto del m\u00f3dulo Ingenier\u00eda (PR10978-25, PR11073-26, 4210109/21217AA00). Distinto de code (referencia interna de obra civil). Vac\u00edo en obras no-ingenier\u00eda."
    },
    "proveedor_instalador": {
      "type": "string",
      "description": "Empresa instaladora del proyecto de ingenier\u00eda (ej. 'SIMANTEC S.L.'). Distinto del client_id (cliente final) y del cliente_contratante_id (comprador)."
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente final / propietario de la obra"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n de la obra"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin prevista"
    },
    "status": {
      "type": "string",
      "enum": [
        "activa",
        "pausada",
        "finalizada",
        "presupuesto"
      ],
      "default": "activa",
      "description": "Estado de la obra (flujo Obras Civiles)"
    },
    "estado_ingenieria": {
      "type": "string",
      "enum": [
        "en_curso",
        "en_revision",
        "cerrado"
      ],
      "description": "Estado del proyecto de ingenier\u00eda (ObraCheck): en_curso, en_revision (los 3 proyectos semila est\u00e1n en_revision), cerrado. Paralelo a status para no romper el flujo de Obras Civiles. Solo aplica si es_proyecto_ingenieria=true."
    },
    "budget": {
      "type": "number",
      "description": "Presupuesto (\u20ac)"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n / alcance"
    },
    "contact_person": {
      "type": "string",
      "description": "Persona de contacto en obra"
    },
    "contact_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "es_proyecto_ingenieria": {
      "type": "boolean",
      "default": false,
      "description": "True si la obra es un proyecto de ingenier\u00eda de instalaciones (BMS, refrigeraci\u00f3n industrial, climatizaci\u00f3n, electricidad). Activa el m\u00f3dulo Ingenier\u00eda/ObraCheck sobre esta obra. Las p\u00e1ginas de Ingenier\u00eda filtran por es_proyecto_ingenieria=true. Default false: obras existentes invisibles al m\u00f3dulo."
    },
    "cliente_contratante_id": {
      "type": "string",
      "description": "ID del cliente que CONTRATA la instalaci\u00f3n. Puede diferir de client_id (cliente final/propietario). En proyectos de ingenier\u00eda, el mismo proveedor factura de forma distinta seg\u00fan qui\u00e9n contrata. Vac\u00edo = el contratante es el client_id existente (retrocompatibilidad)."
    },
    "cliente_contratante_name": {
      "type": "string",
      "description": "Nombre del cliente contratante (denormalizado para listados)."
    },
    "cliente_final_id": {
      "type": "string",
      "description": "Alias expl\u00edcito del client_id cuando hay distinci\u00f3n contratante vs final. Se rellena solo si el flujo lo requiere."
    },
    "clientes_acceso": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails de usuarios con rol cliente_obra autorizados a leer esta obra. Lo mantiene la pantalla Usuarios > Obras asignadas y la regla de lectura lo usa para limitar el acceso del cliente a sus obras."
    },
    "disciplina_ingenieria": {
      "type": "string",
      "enum": [
        "bms",
        "refrigeracion_industrial",
        "climatizacion",
        "electricidad",
        "otro"
      ],
      "description": "Disciplina de ingenier\u00eda del proyecto. Filtra qu\u00e9 prompts de extracci\u00f3n IA y qu\u00e9 fichas t\u00e9cnicas aplicar. Solo aplica si es_proyecto_ingenieria=true."
    },
    "ingeniero_responsable_id": {
      "type": "string",
      "description": "User.id del ingeniero responsable del proyecto (para RLS por ingeniero y filtros)."
    },
    "ingeniero_responsable_name": {
      "type": "string",
      "description": "Nombre del ingeniero responsable (denormalizado)."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        },
        {
          "user_condition": {
            "role": "usuario_demo"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "user_condition": {
            "role": "control_horario"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "cliente_obra"
              }
            },
            {
              "data.clientes_acceso": "{{user.email}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "contabilidad"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "usuario_demo"
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}