{
  "name": "TrazadoEstimado",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID de la obra (denormalizada)."
    },
    "plano_calibracion_id": {
      "type": "string",
      "description": "ID de la PlanoCalibracion sobre la que se dibuja el trazado (para contexto de escala)."
    },
    "ubicacion_origen_id": {
      "type": "string",
      "description": "ID de la UbicacionEquipo de origen del trazado."
    },
    "ubicacion_destino_id": {
      "type": "string",
      "description": "ID de la UbicacionEquipo de destino del trazado."
    },
    "distancia_linea_recta_m": {
      "type": "number",
      "description": "Distancia en l\u00ednea recta entre origen y destino en metros (derivada de la calibraci\u00f3n del plano)."
    },
    "factor_trazado": {
      "type": "number",
      "default": 1.3,
      "description": "Factor de trazado (heur\u00edstica editable, NO medici\u00f3n): distancia_estimada = distancia_linea_recta \u00d7 factor_trazado. Por defecto 1.3. Puede diferir entre cableado el\u00e9ctrico y tuber\u00eda de proceso; editable por proyecto/sala/tipo de trazado."
    },
    "distancia_estimada_m": {
      "type": "number",
      "description": "Distancia estimada del trazado en metros = distancia_linea_recta_m \u00d7 factor_trazado. Se compara contra BaseDePrecio.distancia_maxima_asumida_m para la regla riesgo_precio_distancia."
    },
    "tipo_trazado": {
      "type": "string",
      "enum": [
        "cable_electrico",
        "tuberia_proceso",
        "canal",
        "conducto",
        "otro"
      ],
      "description": "Naturaleza del trazado. Determina el factor_trazado por defecto (el\u00e9ctrico vs. tuber\u00eda de proceso)."
    },
    "tag_circuito_asociado": {
      "type": "string",
      "description": "TAG del circuito asociado al trazado (B1-B10, alimentaci\u00f3n cuadro clima...)."
    },
    "material_id": {
      "type": "string",
      "description": "ID del MaterialCatalog del material del trazado (opcional)."
    },
    "estimado_por": {
      "type": "string",
      "description": "Email del ingeniero que dibuj\u00f3 el trazado estimado."
    },
    "fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO del trazado."
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "obra_id",
    "ubicacion_origen_id",
    "ubicacion_destino_id",
    "tipo_trazado"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "ingeniero"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}