{
  "name": "ReglaDeOro",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "Código único de la regla (ej: VAC-01, ACC-01)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "acceso",
        "vacaciones",
        "fichajes",
        "obras",
        "economico",
        "seguridad",
        "datos",
        "general"
      ],
      "description": "Categoría de la regla"
    },
    "titulo": {
      "type": "string",
      "description": "Título corto de la regla"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción completa de la regla"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "obligatoria",
        "interna",
        "recomendada"
      ],
      "default": "obligatoria",
      "description": "Tipo de regla"
    },
    "estado_cumplimiento": {
      "type": "string",
      "enum": [
        "cumplida",
        "incumplida",
        "no_verificada",
        "pendiente_decision"
      ],
      "default": "no_verificada",
      "description": "Estado actual de cumplimiento"
    },
    "decision_requerida": {
      "type": "boolean",
      "default": false,
      "description": "Si requiere decisión explícita de Dirección"
    },
    "decision_tomada": {
      "type": "string",
      "description": "Decisión tomada por Dirección"
    },
    "decision_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la decisión"
    },
    "decision_por": {
      "type": "string",
      "description": "Email de quien tomó la decisión"
    },
    "ultima_verificacion": {
      "type": "string",
      "format": "date-time",
      "description": "Última vez que se verificó esta regla"
    },
    "notas": {
      "type": "string",
      "description": "Notas internas"
    },
    "activa": {
      "type": "boolean",
      "default": true,
      "description": "Si la regla está activa"
    }
  },
  "required": [
    "codigo",
    "titulo",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
