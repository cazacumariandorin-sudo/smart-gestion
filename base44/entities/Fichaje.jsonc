{
  "name": "Fichaje",
  "type": "object",
  "description": "Registro OPERATIVO de jornada. No es prueba legal: el registro legal oficial vive en RegistroHorarioLegal y solo lo valida administraci\u00f3n.",
  "properties": {
    "operario_id": {
      "type": "string",
      "description": "ID del operario"
    },
    "operario_name": {
      "type": "string",
      "description": "Nombre del operario"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del fichaje"
    },
    "hora_entrada": {
      "type": "string",
      "description": "Hora de entrada (HH:MM)"
    },
    "hora_salida": {
      "type": "string",
      "description": "Hora de salida (HH:MM)"
    },
    "pausa_inicio": {
      "type": "string",
      "description": "Inicio pausa comida (HH:MM)"
    },
    "pausa_fin": {
      "type": "string",
      "description": "Fin pausa comida (HH:MM)"
    },
    "project": {
      "type": "string",
      "description": "Obra donde trabaja (compatibilidad \u2014 igual a obra_name)"
    },
    "obra_id": {
      "type": "string",
      "description": "ID de la obra (FK a Obra o SolarObra)"
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra (desnormalizado)"
    },
    "obra_tipo": {
      "type": "string",
      "enum": [
        "obra_civil",
        "solar",
        "oficina",
        "almacen",
        "otro"
      ],
      "default": "obra_civil",
      "description": "Tipo de obra o lugar de trabajo"
    },
    "horas_trabajadas": {
      "type": "number",
      "description": "Total horas netas trabajadas"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    },
    "origen": {
      "type": "string",
      "enum": [
        "trabajador",
        "gerencia",
        "cierre_forzado_gerencia",
        "cierre_automatico",
        "administracion",
        "importacion"
      ],
      "default": "trabajador",
      "description": "C\u00f3mo se origin\u00f3/cerr\u00f3 el registro. Un cierre forzado o autom\u00e1tico queda marcado aqu\u00ed y NO equivale a un fichaje real del trabajador."
    },
    "cerrado_por": {
      "type": "string",
      "description": "Email del usuario (o 'sistema') que cerr\u00f3 el fichaje cuando no lo cerr\u00f3 el propio trabajador."
    },
    "fecha_cierre": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO del cierre autom\u00e1tico o forzado."
    },
    "motivo_cierre": {
      "type": "string",
      "description": "Motivo del cierre forzado o autom\u00e1tico."
    }
  },
  "required": [
    "operario_id",
    "date",
    "hora_entrada"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "user_condition": {
            "role": "t\u00e9cnico"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "administracion"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "control_horario"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}