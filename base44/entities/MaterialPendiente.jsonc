{
  "name": "MaterialPendiente",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID de la obra (Obra o SolarObra)"
    },
    "obra_name": {
      "type": "string",
      "description": "Nombre de la obra (desnormalizado)"
    },
    "obra_tipo": {
      "type": "string",
      "enum": [
        "obra_civil",
        "solar",
        "oficina",
        "almacen",
        "otro"
      ],
      "default": "obra_civil"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "parte_id": {
      "type": "string",
      "description": "ID del ParteDiarioObra que originó esta solicitud de material"
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la solicitud (fecha del parte)"
    },
    "solicitado_por_email": {
      "type": "string"
    },
    "solicitado_por_nombre": {
      "type": "string"
    },
    "solicitado_por_rol": {
      "type": "string"
    },
    "descripcion": {
      "type": "string",
      "description": "Detalle del material necesario (texto apuntado en el parte)"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta"
      ],
      "default": "media"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "solicitado",
        "recibido"
      ],
      "default": "pendiente",
      "description": "Pendiente → Solicitado a proveedor → Recibido en obra"
    },
    "notas_admin": {
      "type": "string"
    },
    "fecha_resolucion": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se marcó como recibido"
    },
    "resuelto_por": {
      "type": "string"
    },
    "mes": {
      "type": "string",
      "description": "Clave mensual YYYY-MM (desnormalizada)"
    },
    "anio": {
      "type": "number"
    },
    "mes_numero": {
      "type": "number"
    }
  },
  "required": [
    "descripcion",
    "fecha_solicitud"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        },
        {
          "user_condition": {
            "role": "jefe_obra"
          }
        },
        {
          "user_condition": {
            "role": "técnico"
          }
        },
        {
          "user_condition": {
            "role": "operario"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.solicitado_por_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        },
        {
          "user_condition": {
            "role": "gerencia"
          }
        },
        {
          "user_condition": {
            "role": "director_comercial"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "propietario"
          }
        }
      ]
    }
  }
}
