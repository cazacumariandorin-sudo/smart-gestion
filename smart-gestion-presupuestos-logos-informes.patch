+                </Button>
+                <Button type="button" size="sm" variant="ghost" onClick={() => setAbierto(null)}><X className="h-4 w-4" /></Button>
+              </div>
+            </div>
+            <div className="flex-1 overflow-y-auto p-4"><InformeTecnicoResumen informe={abierto} /></div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
