diff --git a/base44/shared/presupuesto.test.mjs b/base44/shared/presupuesto.test.mjs
index 6b543f2..81964c0 100644
--- a/base44/shared/presupuesto.test.mjs
+++ b/base44/shared/presupuesto.test.mjs
@@ -70,6 +70,9 @@ const ex = [{ id: 'a', estado: 'borrador', partes_trabajo_ids: ['p1'], conceptos
 t('partes: ocupado en borrador, libre si rechazado, el propio no cuenta', R.conflictoPartes(['p1'], ex)?.id === 'a' && R.conflictoPartes(['p3'], ex) === null && R.conflictoPartes(['p1'], ex, 'a') === null);
 t('extras: ocupado en borrador, libre si rechazado, el propio no cuenta', R.conflictoExtras([{ extra_id: 'e1' }], ex)?.id === 'a' && R.conflictoExtras([{ extra_id: 'e3' }], ex) === null && R.conflictoExtras([{ extra_id: 'e1' }], ex, 'a') === null);
 t('solo campos editables (no estado, código, importe ni historial)', JSON.stringify(Object.keys(R.soloCamposEditables({ cliente_id: 'c', estado: 'aceptado', codigo_registro: 'X', importe: 1, notas: 'n', conceptos: [] })).sort()) === JSON.stringify(['cliente_id', 'conceptos', 'notas']));
+t('logo_id: se conserva uno válido', R.soloCamposEditables({ logo_id: 'alternativo' }).logo_id === 'alternativo');
+t('logo_id: uno desconocido vuelve a principal', R.soloCamposEditables({ logo_id: 'hackeado' }).logo_id === 'principal');
+t('logo_id: si no viene, no se inventa', !('logo_id' in R.soloCamposEditables({ notas: 'n' })));
 
 // ═══ 3) FUNCIONES con base de datos simulada ═════════════════════════════════
 const llamar = async (fn, user, body) => { globalThis.__ctx.user = user; const rs = await handlers[fn](new Request('http://x/', { method: 'POST', body: JSON.stringify(body) })); return { s: rs.status, j: await rs.json() }; };
diff --git a/base44/shared/presupuestoReglas.ts b/base44/shared/presupuestoReglas.ts
index 156e610..8c97c79 100644
--- a/base44/shared/presupuestoReglas.ts
+++ b/base44/shared/presupuestoReglas.ts
@@ -82,9 +82,12 @@ export function conflictoExtras(conceptos: any[], existentes: any[], excluirId?:
 
 /** Solo estos campos pueden venir del cliente (nunca estado, código, historial ni importes calculados). */
 export const CAMPOS_EDITABLES = ['titulo', 'cliente_id', 'cliente_name', 'fecha', 'descripcion', 'notas', 'forma_pago', 'referencia_cliente',
-  'valido_hasta', 'obra_id', 'obra_name', 'conceptos', 'partes_trabajo_ids', 'file_url', 'documentos_origen'];
+  'valido_hasta', 'obra_id', 'obra_name', 'conceptos', 'partes_trabajo_ids', 'file_url', 'documentos_origen', 'logo_id'];
+/** Logotipos disponibles para el PDF. Debe coincidir con src/lib/presupuestoLogos.js (el frontend no puede importar de base44/shared). */
+export const LOGOS_VALIDOS = ['principal', 'alternativo'];
 export function soloCamposEditables(body: Record<string, any>): Record<string, any> {
   const out: Record<string, any> = {};
   for (const k of CAMPOS_EDITABLES) if (body && body[k] !== undefined) out[k] = body[k];
+  if (out.logo_id !== undefined && !LOGOS_VALIDOS.includes(out.logo_id)) out.logo_id = 'principal';
   return out;
 }
